# board-server/.env.example
# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다.
# 다른 서버의 .env 와 따로 둔다.

# 서버가 듣는 주소와 포트. 적지 않으면 127.0.0.1 과 8002 다.
# 인증 서버가 8000, 게임 서버가 8001 을 쓴다
HOST=127.0.0.1
PORT=8002

# DB 접속 주소. 반드시 적는다. 적지 않으면 서버가 뜨지 않는다.
# 비밀번호는 루트 .env 의 BOARD_DB_PASSWORD 와 같은 값이다. 포트는 루트 .env 의 POSTGRES_PORT 다.
# 게임 서버의 주소와 모양이 다르다. postgresql+asyncpg:// 가 아니라 postgresql:// 로 시작한다
DATABASE_URL=postgresql://board:여기에비밀번호@127.0.0.1:5432/trpg

# 테이블을 두는 스키마. 적지 않으면 board 다. 테스트는 board_test 로 고정한다
# DB_SCHEMA=board

# 인증 서버가 공개키를 내주는 주소(JWKS). 반드시 적는다. 적지 않으면 서버가 뜨지 않는다.
# 이 주소에서 받은 키로 토큰의 서명을 확인한다. 인증 서버가 꺼져 있어도 이 서버는 뜬다
AUTH_JWKS_URL=http://127.0.0.1:8000/api/v1/auth/jwks

# 믿는 토큰의 발급자(iss)와 이 서버의 이름(aud). 적지 않으면 ai-trpg-auth 와 ai-trpg-board 다.
# 발급자는 인증 서버의 JWT_ISSUER 와 같아야 하고, 이 서버의 이름은 인증 서버의 JWT_AUDIENCE 목록에 있어야 한다.
# 이 서버의 이름은 하나만 적는다. 인증 서버의 목록을 그대로 옮겨 적지 않는다
# JWT_ISSUER=ai-trpg-auth
# JWT_AUDIENCE=ai-trpg-board
