# board-server/.env.example
# 게시판 서버 설정. board-server/.env 를 만들고 값을 채운다. .env 는 커밋하지 않는다. 다른 서버의 .env 와 따로 둔다.
#
# 비밀(DB 비밀번호, NOTIFICATION_SECRET)은 저장소 루트에서 이 명령이 채운다. 알림 서버의 짝과 같은 값으로 맞춘다
#   uv run --no-project python tools/fill_env.py
# 손으로 만들려면 복사해서 값을 채운다:  cp .env.example .env

# 서버가 듣는 주소. 적지 않으면 127.0.0.1 이다
HOST=127.0.0.1
# 서버가 듣는 포트. 적지 않으면 8002 다. 인증 서버가 8000, 게임 서버가 8001 을 쓴다
PORT=8002

# DB 접속 주소. 반드시 적는다. 적지 않으면 서버가 뜨지 않는다.
# 비밀번호는 루트 .env 의 BOARD_DB_PASSWORD 와 같은 값이다(tools/fill_env.py 가 맞춘다). 포트는 루트 .env 의 POSTGRES_PORT 다.
# 게임 서버의 주소와 모양이 다르다. postgresql+asyncpg:// 가 아니라 postgresql:// 로 시작한다
DATABASE_URL=postgresql://board:여기에비밀번호@127.0.0.1:5432/trpg

# 테이블을 두는 스키마. 적지 않으면 board 다. 테스트는 board_test 로 고정한다
# DB_SCHEMA=board

# 인증 서버가 공개키를 내주는 주소(JWKS). 반드시 적는다. 적지 않으면 서버가 뜨지 않는다.
# 이 주소에서 받은 키로 토큰의 서명을 확인한다. 인증 서버가 꺼져 있어도 이 서버는 뜬다
AUTH_JWKS_URL=http://127.0.0.1:8000/api/v1/auth/jwks

# 인증 서버가 끊긴 세션의 목록을 내주는 주소. 적지 않으면 공개키 주소의 옆(…/jwks → …/session-revocations)이다.
# 30초마다 받아, 끊긴 세션의 토큰을 거부한다. 공개키 주소가 /jwks 로 끝나지 않을 때만 적는다
# AUTH_SESSION_REVOCATIONS_URL=http://127.0.0.1:8000/api/v1/auth/session-revocations

# 믿는 토큰의 발급자(iss). 적지 않으면 ai-trpg-auth 다. 인증 서버의 JWT_ISSUER 와 같아야 한다
# JWT_ISSUER=ai-trpg-auth
# 이 서버의 이름(aud). 적지 않으면 ai-trpg-board 다. 인증 서버의 JWT_AUDIENCE 목록에 있어야 한다.
# 이 서버의 이름은 하나만 적는다. 인증 서버의 목록을 그대로 옮겨 적지 않는다
# JWT_AUDIENCE=ai-trpg-board

# --- 로그에 실리는 값들 ---
# 비밀값이 아니다. 규격은 저장소 루트의 docs/observability.md 에 있다.
# 이 서버가 도는 환경의 이름. 적지 않으면 development 다. 운영에서는 production 으로 적는다
# APP_ENVIRONMENT=development
# 배포한 코드의 버전. 적지 않으면 dev 다. 운영에서는 배포할 때 git SHA 나 이미지 태그를 넣는다
# APP_VERSION=dev
# 이 수준부터 로그를 남긴다. debug, info, warning, error 중 하나다. 적지 않으면 info 다
# LOG_LEVEL=info

# --- 사용자의 알림함(알림 서버) ---
# 내 글의 댓글, 내 댓글의 답글을 알린다(#385). 적지 않으면 알림을 발송함에 적기만 한다. 보내려면 NOTIFICATION_URL 의 # 를 지운다.
# 알림 서버의 주소
# NOTIFICATION_URL=http://127.0.0.1:8004
# 알림 서버를 부를 때 서명하는 비밀. notification-server/.env 의 BOARD_SERVER_SECRET 과 같은 값이다. 32자 이상. 비밀값이다.
# tools/fill_env.py 가 두 파일에 같은 값을 채우고 주석을 푼다
# NOTIFICATION_SECRET=
