# trpg-server/.env.example
# 게임 서버 설정. trpg-server/.env 를 만들고 값을 채운다. .env 는 커밋하지 않는다. 인증 서버의 .env 와 따로 둔다.
#
# 비밀(DB 비밀번호, 서버끼리의 비밀, 신호와 기록의 키)은 저장소 루트에서 이 명령이 채운다. 다른 서버의 짝과 같은 값으로 맞춘다
#   uv run --no-project python tools/fill_env.py
# 손으로 만들려면 복사해서 값을 채운다:  cp .env.example .env

# 개발용 기능(API 문서 화면)을 켠다. 운영에서는 적지 않거나 false 로 둔다
DEBUG=true

# DB 접속 주소. 비밀번호는 루트 .env 의 GAME_DB_PASSWORD 와 같은 값이다(tools/fill_env.py 가 맞춘다).
# 포트는 루트 .env 의 POSTGRES_PORT 다. 비동기 드라이버라 postgresql+asyncpg:// 로 시작한다
DATABASE_URL=postgresql+asyncpg://game:여기에비밀번호@127.0.0.1:5432/trpg

# 인증 서버가 공개키를 내주는 주소. 이 주소에서 받은 키로 서명된 토큰을 믿는다
AUTH_JWKS_URL=http://127.0.0.1:8000/api/v1/auth/jwks

# 인증 서버가 끊긴 세션의 목록을 내주는 주소. 적지 않으면 AUTH_JWKS_URL 옆(…/session-revocations)이다
# AUTH_SESSION_REVOCATIONS_URL=http://127.0.0.1:8000/api/v1/auth/session-revocations

# --- 서술(언어 모델) ---
# GM 의 서술을 누가 쓰나. 적지 않으면 fake(AI 를 부르지 않는 가짜)다. llm 이면 아래의 모델을 부른다.
# 언어 모델로 서술하려면 아래 줄들의 # 를 지운다. 기본 주소는 같은 PC 의 Ollama 다
# NARRATOR=llm
# 서술에 쓰는 모델. Ollama 의 모델 이름이나, 모델 목록(scripts/models.py)의 이름표(gpt-6-luna 등)다
# LLM_MODEL=gemma4:26b
# 모델을 부르는 주소(OpenAI 와 같은 모양의 API). 기본은 같은 PC 의 Ollama 다
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# 모델의 답을 기다리는 가장 긴 시간(초)
# LLM_TIMEOUT_SECONDS=60
# 첫 모델이 끝내 실패하면 차례로 넘어갈 모델들(쉼표로 나눔). 비우면 넘어가지 않는다
# LLM_FALLBACK_MODELS=
# 모델이 추론 수준(reasoning_effort)을 아는지. 모르면 false 로 둔다
# LLM_SUPPORTS_REASONING=true
# 모델 목록의 openai 창구 모델을 부를 키. 비밀값이다. 비우면 그 모델들을 부르지 않는다.
# LLM_MODEL 에 목록의 이름표를 적으면 목록대로 부른다. 키에 월 사용 한도를 걸어 둔다. OpenAI 가 내주는 값이라 tools/fill_env.py 가 만들지 않는다
# OPENAI_API_KEY=
# openai 창구의 주소. 바꿀 일이 거의 없다
# OPENAI_BASE_URL=https://api.openai.com/v1
# 모델 목록의 anthropic 창구(Claude) 모델을 부를 키. 비밀값이다. 비우면 그 모델들을 부르지 않는다. tools/fill_env.py 가 만들지 않는다
# ANTHROPIC_API_KEY=
# anthropic 창구의 주소. 바꿀 일이 거의 없다
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# 모델 목록의 gemini 창구 모델을 부를 키. 비밀값이다. 비우면 그 모델들을 부르지 않는다. tools/fill_env.py 가 만들지 않는다
# GEMINI_API_KEY=
# gemini 창구의 주소. 바꿀 일이 거의 없다
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# 모델 목록의 zai 창구(GLM) 모델을 부를 키. 비밀값이다. 비우면 그 모델들을 부르지 않는다. 처리 서버가 싱가포르다.
# tools/fill_env.py 가 만들지 않는다
# ZAI_API_KEY=
# zai 창구의 주소. 바꿀 일이 거의 없다
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# 모델 목록의 deepinfra 창구(DeepSeek) 모델을 부를 키(#398). 비밀값이다. 비우면 그 모델들을 부르지 않는다.
# 처리 서버가 미국이다. tools/fill_env.py 가 만들지 않는다
# DEEPINFRA_API_KEY=
# deepinfra 창구의 주소. 바꿀 일이 거의 없다
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# 서술을 동시에 몇 개까지 돌리나. 넘는 것은 차례를 기다린다. 모델이 한 번에 받는 수(OLLAMA_NUM_PARALLEL 등)에 맞춘다
# JOB_NARRATION_CONCURRENCY=4
# 색인(로어북, 기억)을 종류마다 동시에 몇 개까지 돌리나
# JOB_INDEX_CONCURRENCY=2
# AI 호출의 기록에 남은 원문(모델이 쓴 글)을 며칠 두나. 지나면 원문만 비운다
# AI_LOG_TEXT_RETENTION_DAYS=30

# 로비의 비밀번호와 채팅의 시도 횟수를 세는 Redis(#56). 비우면 서버 안의 메모리로 센다(서버가 하나일 때만 맞다).
# docker compose up -d 로 띄운 Redis 다. 인증 서버와 같은 것을 써도 된다(키의 앞부분이 다르다)
# REDIS_URL=redis://127.0.0.1:6379/0

# --- 임베딩과 검색 ---
# 로어북 항목을 벡터로 바꾸는 것(임베딩)을 누가 하나. 적지 않으면 fake(모델을 부르지 않는 가짜)다.
# 임베딩 모델을 쓰려면 아래 줄들의 # 를 지운다. 먼저 ollama pull bge-m3
# EMBEDDER=llm
# 임베딩에 쓰는 모델의 이름
# EMBEDDING_MODEL=bge-m3
# 임베딩 모델을 부르는 주소. 비우면 LLM_BASE_URL 과 같은 주소다
# EMBEDDING_BASE_URL=
# 임베딩의 답을 기다리는 가장 긴 시간(초)
# EMBEDDING_TIMEOUT_SECONDS=30
# 벡터의 길이(차원). 적으면 길이가 다른 답을 받지 않는다. bge-m3 는 1024 다. 적지 않으면 보지 않는다
# EMBEDDING_DIMENSIONS=1024
# 로어북 검색에서 이보다 먼 항목은 버린다(거리 기준). bge-m3 로 잰 값이다. 임베딩 모델을 바꾸면 scripts.eval_lore 로 다시 재서 고친다
# LORE_MAX_DISTANCE=0.45
# 키워드가 맞은 로어북 항목에 쓰는 거리 기준. 키워드가 맞으면 조금 더 먼 것까지 받는다
# LORE_KEYWORD_MAX_DISTANCE=0.50
# 지난 일(앞 라운드의 기억) 검색의 거리 기준. bge-m3 로 잰 값이다. 임베딩 모델을 바꾸면 scripts.eval_memory 로 다시 잰다
# MEMORY_MAX_DISTANCE=0.40
# 키워드가 맞은 지난 일에 쓰는 거리 기준
# MEMORY_KEYWORD_MAX_DISTANCE=0.50

# --- 이 서버만 아는 비밀 ---
# AI 호출의 기록에 남기는 입력 지문(HMAC)의 키. 비우면 지문을 남기지 않는다. 비밀값이다.
# tools/fill_env.py 가 주석인 채로 값만 채운다. 쓰려면 # 를 지운다
# AI_LOG_HMAC_KEY=
# 실시간 신호(NOTIFY)에 서명하는 비밀(#75). 32자 이상. 같은 DB 의 다른 계정이 신호를 꾸며 보내지 못하게 한다.
# 비우면 서버가 뜰 때마다 무작위로 만든다(서버가 하나면 된다). 서버를 여럿 띄우면 같은 값을 적는다. 비밀값이다.
# tools/fill_env.py 가 주석인 채로 값만 채운다. 쓰려면 # 를 지운다
# SIGNAL_SECRET=

# --- 로그에 실리는 값들 ---
# 비밀값이 아니다. 규격은 저장소 루트의 docs/observability.md 에 있다.
# 이 서버가 도는 환경의 이름. 적지 않으면 development 다. 운영에서는 production 으로 적는다
# APP_ENVIRONMENT=development
# 배포한 코드의 버전. 적지 않으면 dev 다. 운영에서는 배포할 때 git SHA 나 이미지 태그를 넣는다
# APP_VERSION=dev
# 이 수준부터 로그를 남긴다. debug, info, warning, error 중 하나다. 적지 않으면 info 다
# LOG_LEVEL=info
# span 과 메트릭을 OTLP(HTTP)로 미는 수집기(Alloy)의 주소. 경로 없이 적는다. 적지 않으면 내보내지 않는다(README 의 "추적", "메트릭").
# PC 에서 직접 띄울 때는 적지 않는다. compose 는 루트 .env 의 같은 이름을 넘긴다
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# 메트릭을 보내는 간격(밀리초). 1000 이상. 적지 않으면 15000 이다
# OTEL_METRIC_EXPORT_INTERVAL=15000

# --- 결제 서버(라운드의 서술 값) ---
# 라운드의 서술 값을 받는 결제 서버. 적지 않으면 받지 않는다(결제 서버 없이 개발할 때).
# 받으려면 아래 줄들의 # 를 지운다.
# 결제 서버의 주소
# BILLING_URL=http://127.0.0.1:8003
# 결제 서버를 부를 때 서명하는 비밀. 결제 서버의 GAME_SERVER_SECRET 과 같은 값이다. 비밀값이다(tools/fill_env.py 가 맞추고 주석을 푼다)
# BILLING_SECRET=
# 결제 서버의 답을 기다리는 가장 긴 시간(초)
# BILLING_TIMEOUT_SECONDS=5

# --- 알림 서버(방장에게 보내는 알림) ---
# 방장에게 보내는 알림을 넣는 알림 서버. 적지 않으면 보내지 않고 발송함에 적기만 한다(알림 서버 없이 개발할 때).
# 보내려면 아래 줄들의 # 를 지운다.
# 알림 서버의 주소
# NOTIFICATION_URL=http://127.0.0.1:8004
# 알림 서버를 부를 때 서명하는 비밀. 알림 서버의 GAME_SERVER_SECRET 과 같은 값이고 BILLING_SECRET 과 다르다.
# 비밀값이다(tools/fill_env.py 가 맞추고 주석을 푼다)
# NOTIFICATION_SECRET=
# 알림 서버의 답을 기다리는 가장 긴 시간(초)
# NOTIFICATION_TIMEOUT_SECONDS=5
