        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_filesystem_avail_bytes{job=\"disks\"}",
          "legendFormat": "{{disk}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "지금 속도면 가득 차기까지",
      "description": "지난 6시간의 기울기로 셈한 시간. 줄지 않는 디스크는 비어 있다. 하루 안이면 DiskFillingUp 이 울린다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 14400
              },
              {
                "color": "green",
                "value": 604800
              }
            ]
          },
          "noValue": "줄지 않는다"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(node_filesystem_avail_bytes{job=\"disks\"} / -deriv(node_filesystem_avail_bytes{job=\"disks\"}[6h])) > 0",
          "legendFormat": "{{disk}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "id": 5,
      "title": "얼마씩 느는가",
