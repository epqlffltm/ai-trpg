{
  "uid": "disks",
  "title": "디스크",
  "description": "디스크마다(system: OS 와 Docker, db: DB, observability: 로그·메트릭·추적) 크기와 남은 양, 느는 속도. Alloy 안의 node_exporter 가 잰다(#539). 규칙은 docs/observability.md 의 \"대시보드\"에 있다",
  "tags": [
    "disks"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "한눈에",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "남은 공간",
      "description": "디스크마다 남은 비율. 15% 밑이면 DiskSpaceLow, 5% 밑이면 DiskSpaceCritical 이 울린다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "green",
                "value": 0.15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_filesystem_avail_bytes{job=\"disks\"} / node_filesystem_size_bytes{job=\"disks\"}",
          "legendFormat": "{{disk}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "남은 양",
      "description": "디스크마다 남은 바이트",
