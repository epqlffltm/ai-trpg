        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_total{service=\"trpg-server\", status_code=~\"5..\"}[$__rate_interval])) / (sum(rate(http_server_requests_total{service=\"trpg-server\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx",
          "refId": "A",
          "range": false,
          "instant": true
        }
