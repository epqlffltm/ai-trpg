          "expr": "sum by (cmd) (rate(redis_commands_total{job=\"redis\"}[$__rate_interval]))",
          "legendFormat": "{{cmd}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "키 적중률",
      "description": "찾은 키 가운데 있던 것의 비율. 시도 횟수 제한은 처음 보는 키가 많아 낮아도 이상하지 않다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
