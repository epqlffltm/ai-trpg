          "expr": "rate(redis_keyspace_hits_total{job=\"redis\"}[$__rate_interval]) / (rate(redis_keyspace_hits_total{job=\"redis\"}[$__rate_interval]) + rate(redis_keyspace_misses_total{job=\"redis\"}[$__rate_interval]) > 0)",
          "legendFormat": "적중률",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
