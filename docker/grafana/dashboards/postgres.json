    {
      "type": "timeseries",
      "id": 7,
      "title": "상태마다의 연결",
      "description": "trpg 에 붙은 연결을 상태마다 센다. idle in transaction 이 오래 남으면 트랜잭션을 닫지 않은 코드가 있다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (pg_stat_activity_count{job=\"postgres\", datname=\"trpg\"})",
          "legendFormat": "{{state}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
