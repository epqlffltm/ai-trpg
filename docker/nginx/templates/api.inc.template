# docker/nginx/templates/api.inc.template
# API 를 받는 server 의 몸통: 서버에 넘기는 머리말, 주소마다 어느 서버로 보낼지, 막는 주소, nginx 가 직접 답하는 본문.
# 로컬의 8080(default.conf.template)과 staging 의 8443(docker/nginx/staging/default.conf.template)이 server 안에서 include 한다.
# 듣는 포트(listen)와 TLS, 허용 주소는 include 하는 쪽이 정한다.
#
# 이미지가 뜰 때 ${이름} 을 바꿔 /etc/nginx/conf.d/api.inc 로 쓴다(바꿀 것은 없다).
#
# 하는 일:
#   - /api/v1/<서버>/ 를 그 서버에 보낸다. 주소는 고쳐 쓰지 않는다. 그 밖의 주소는 모두 404 다.
#     관리자 화면(/admin/, /static/), 서버의 /health, 서버끼리만 부르는 /api/v1/billing/service/, /api/v1/auth/service/,
#     /api/v1/notification/service/ 도 여기서 404 다(#18).
#     막은 주소도 403 이 아니라 404 다. 그런 주소가 있다는 것조차 알리지 않는다.
#   - IP 마다 요청 수를 센다(#22). 넘으면 429 다. 인증 서버의 제한(Redis)이 꺼져 있어도 바깥에서 막는다.
#   - 요청 식별자(X-Request-ID)를 nginx 가 정해 서버에 넘긴다. nginx 의 줄과 서버의 줄이 같은 request_id 로 이어진다.
#   - 클라이언트가 지어 보낸 IP 와 출처의 머리말(X-Real-IP, Forwarded, X-Forwarded-Host)을 덮거나 지운다(#353, README 의 "외부에 열기 전").
#   - 모든 응답에 보안 머리말(nosniff, CSP, Referrer-Policy, HTTPS 면 HSTS)을 붙인다(#361, security-headers.inc.template).
#     add_header 를 쓰는 location 은 그 파일을 include 한다. 안 하면 server 의 것을 물려받지 못한다.
#   - 로그를 공통 규격(docs/observability.md)의 JSON 으로 남긴다. 경로와 주소 뒤의 값은 적지 않는다.

# 응답 머리말과 오류 화면에 nginx 의 버전을 싣지 않는다
server_tokens off;

access_log /dev/stdout proxy_json;
# 위의 이유로 오류 로그는 crit 만 남긴다. 서버에 닿지 못한 일(502, 504)은 JSON 로그의 status_code 와 upstream 에 있다
error_log /dev/stderr crit;

# 요청을 보낸 서버의 이름. 로그에 싣는다. 아래의 location 마다 바꾼다
set $proxy_upstream proxy;
# 429 에 실어 보낼 Retry-After(초). 제한마다 다르다
set $retry_after 1;

# 서버에 넘기는 머리말. location 에서 proxy_set_header 를 하나라도 쓰면 여기 것을 물려받지 못하므로 여기에만 둔다.
# 요청 식별자는 nginx 가 정한다. 클라이언트가 보낸 X-Request-ID 는 버린다
proxy_set_header X-Request-ID $request_id;
proxy_set_header Host $host;
# 받은 X-Forwarded-For 뒤에 nginx 에 연결한 상대의 주소를 덧붙인다. 앞쪽은 클라이언트가 지어낼 수 있다.
# 인증 서버는 뒤에서 TRUSTED_PROXY_COUNT(1) 번째만 믿는다(accounts/client_ip.py)
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# staging 에서는 nginx 가 TLS 를 끝내므로 https 다. 인증 서버가 이것으로 HTTPS 를 안다(SECURE_PROXY_SSL_HEADER)
proxy_set_header X-Forwarded-Proto $scheme;
# 클라이언트가 지어 보낸 IP 와 출처의 머리말을 서버에 넘기지 않는다(#353). 프록시 뒤의 서버가 믿을 수 있는 것은 위의 넷뿐이다.
# X-Real-IP 는 nginx 에 연결한 상대의 주소로 덮는다. 결제 서버(gin)처럼 이 머리말을 읽는 라이브러리가 있다.
# Forwarded(RFC 7239)와 X-Forwarded-Host 는 지운다(빈 값이면 nginx 가 보내지 않는다). 이 저장소의 서버는 읽지 않는다
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header Forwarded "";
proxy_set_header X-Forwarded-Host "";
# 보안 머리말(#361). 서버가 보낸 같은 머리말(인증 서버의 nosniff, Referrer-Policy 등)은 지우고 이 값 하나만 보낸다.
# 여기 것은 add_header 가 없는 location(서버에 넘기는 곳)이 물려받는다
proxy_hide_header X-Content-Type-Options;
proxy_hide_header Content-Security-Policy;
proxy_hide_header Referrer-Policy;
proxy_hide_header Strict-Transport-Security;
include /etc/nginx/conf.d/security-headers.inc;
# 서버와의 연결을 HTTP/1.1 로 맺는다. SSE 가 끊기지 않고 흐른다
proxy_http_version 1.1;
proxy_set_header Connection "";

# nginx 가 직접 답할 때의 본문. 서버들과 같은 모양이다
error_page 429 @too_many_requests;
error_page 502 @bad_gateway;
error_page 504 @gateway_timeout;

# --- 인증 서버 ---
location /api/v1/auth/ {
    set $proxy_upstream auth;
    set $auth_server auth-server:8000;
    limit_req zone=api burst=40 nodelay;
    proxy_pass http://$auth_server;
}

# 로그인, 인증 코드, 가입, 비밀번호. 인증 서버의 제한(Redis)이 꺼져 있어도 여기서 막는다.
# 인증 코드 확인(login/verify)과 비밀번호 재설정 확인(password/reset/confirm)은 인증 서버에 제한이 없다. 그 자리를 여기서 메운다
location ~ ^/api/v1/auth/(login|login/verify|login/resend|signup|signup/verify|signup/complete|password/change|password/reset|password/reset/confirm)$ {
    set $proxy_upstream auth;
    set $auth_server auth-server:8000;
    set $retry_after 6;
    limit_req zone=auth_sensitive burst=10 nodelay;
    proxy_pass http://$auth_server;
}

# 결제 서버만 부르는 주소(보호자 알림, #352). 결제 서버는 프록시를 거치지 않고 컨테이너끼리 부른다
location ^~ /api/v1/auth/service/ {
    types { }
    add_header X-Request-ID $request_id always;
    include /etc/nginx/conf.d/security-headers.inc;
    return 404 '{"detail":"찾을 수 없습니다."}';
}

# --- 게임 서버 ---
location /api/v1/game/ {
    set $proxy_upstream game;
    set $game_server game-server:8001;
    limit_req zone=api burst=40 nodelay;
    proxy_pass http://$game_server;
}

# 테이블의 실시간 흐름(SSE). 끝나지 않는 응답이다.
# 서버가 X-Accel-Buffering: no 를 보내지만, 이 주소에서는 nginx 쪽에서도 모으지 않게 못 박는다.
# 서버가 15초마다 하트비트를 보내므로 기본 읽기 시간(60초) 안에 끊기지 않는다
location ~ ^/api/v1/game/tables/[^/]+/stream$ {
    set $proxy_upstream game;
    set $game_server game-server:8001;
    limit_req zone=api burst=40 nodelay;
    limit_conn streams 10;
    proxy_buffering off;
    proxy_pass http://$game_server;
}

# --- 게시판 서버 ---
location /api/v1/board/ {
    set $proxy_upstream board;
    set $board_server board-server:8002;
    limit_req zone=api burst=40 nodelay;
    proxy_pass http://$board_server;
}

# 글 검색. 게시판 하나의 글 목록(/boards/:slug/posts)과 다른 주소다
location = /api/v1/board/posts {
    set $proxy_upstream board;
    set $board_server board-server:8002;
    set $retry_after 1;
    limit_req zone=search burst=5 nodelay;
    proxy_pass http://$board_server;
}

# --- 결제 서버 ---
# 결제 대행사의 웹훅(/api/v1/billing/webhooks/payment)도 여기로 간다. 바깥에서 와야 한다
location /api/v1/billing/ {
    set $proxy_upstream billing;
    set $billing_server billing-server:8003;
    limit_req zone=api burst=40 nodelay;
    proxy_pass http://$billing_server;
}

# 게임 서버와 인증 서버만 부르는 주소. 그 서버들은 프록시를 거치지 않고 컨테이너끼리 부른다
location ^~ /api/v1/billing/service/ {
    # 주소의 확장자(.css 등)로 형식을 고르지 않는다. 본문은 늘 JSON 이다
    types { }
    add_header X-Request-ID $request_id always;
    include /etc/nginx/conf.d/security-headers.inc;
    return 404 '{"detail":"찾을 수 없습니다."}';
}

# --- 알림 서버 ---
location /api/v1/notification/ {
    set $proxy_upstream notification;
    set $notification_server notification-server:8004;
    limit_req zone=api burst=40 nodelay;
    proxy_pass http://$notification_server;
}

# 다른 서버만 부르는 주소(알림 넣기). 그 서버들은 프록시를 거치지 않고 컨테이너끼리 부른다
location ^~ /api/v1/notification/service/ {
    types { }
    add_header X-Request-ID $request_id always;
    include /etc/nginx/conf.d/security-headers.inc;
    return 404 '{"detail":"찾을 수 없습니다."}';
}

# --- 그 밖의 모든 주소 ---
# 관리자 화면(/admin/, /static/), 서버들의 /health 도 여기에 걸린다.
# 관리자 화면은 SSH 터널로 인증 서버의 포트(127.0.0.1:8000)에 직접 붙어서 쓴다(README)
location / {
    # 주소의 확장자(.css 등)로 형식을 고르지 않는다. 본문은 늘 JSON 이다
    types { }
    add_header X-Request-ID $request_id always;
    include /etc/nginx/conf.d/security-headers.inc;
    return 404 '{"detail":"찾을 수 없습니다."}';
}

# 아래의 본문들은 오류를 답하는 자리다. allow all 은 staging 의 허용 주소(deny all) 때문이다.
# 허용 주소 밖의 요청이 여기로 넘어와도 막히지 않고 이 본문을 받는다. 로컬에는 허용 주소가 없어 아무 일도 하지 않는다
location @too_many_requests {
    allow all;
    add_header Retry-After $retry_after always;
    add_header X-Request-ID $request_id always;
    include /etc/nginx/conf.d/security-headers.inc;
    return 429 '{"detail":"요청이 너무 많습니다. 잠시 뒤에 다시 시도하세요.","code":"too_many_requests"}';
}

location @bad_gateway {
    allow all;
    add_header X-Request-ID $request_id always;
    include /etc/nginx/conf.d/security-headers.inc;
    return 502 '{"detail":"서버에 닿지 못했습니다. 잠시 뒤에 다시 시도하세요."}';
}

location @gateway_timeout {
    allow all;
    add_header X-Request-ID $request_id always;
    include /etc/nginx/conf.d/security-headers.inc;
    return 504 '{"detail":"서버가 제때 답하지 않았습니다. 잠시 뒤에 다시 시도하세요."}';
}

# nginx 가 직접 답하는 본문은 JSON 이다. 서버가 답한 것은 서버가 정한 형식 그대로다.
# nginx 가 답할 때는 location 마다 X-Request-ID 를 붙인다. 여기서 붙이면 서버가 돌려준 것과 두 번 실린다.
# location 에 add_header 를 쓰면 보안 머리말도 사라지므로 security-headers.inc 를 함께 include 한다
default_type application/json;
