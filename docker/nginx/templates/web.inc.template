# docker/nginx/templates/web.inc.template
# 화면(SPA, #290)을 내주는 곳. api.inc.template 이 server 의 맨 끝에서 include 한다. 로컬(8080)과 staging(8443)이 같다.
#
# 이미지가 뜰 때 ${이름} 을 바꿔 /etc/nginx/conf.d/web.inc 로 쓴다(바꿀 것은 없다).
# 끝이 .conf 가 아니라서 nginx 가 http 에서 저절로 읽지 않는다. include 한 곳에서만 쓰인다.
#
# 파일은 프록시의 이미지에 구워져 있다(web/Dockerfile 의 /usr/share/nginx/web). 화면을 고치면 이미지를 다시 만든다.
# 정한 것(docs/product/screens.md 의 "시작할 때 정한 것"):
#   - 해시가 붙은 파일(/assets/)은 오래 캐시한다. 내용이 바뀌면 이름이 바뀐다.
#   - index.html 과 그 밖의 파일은 캐시하지 않는다(no-cache: 쓰기 전에 늘 새것인지 묻는다). 새로 올리면 바로 새 화면이다.
#   - 파일이 없는 주소(/login, /trpg/tables/...)는 index.html 로 돌린다. 경로는 화면(React Router)이 나눈다.
#   - /api/, /admin/, /static/, /health 는 여기에 오지 않는다. api.inc 가 먼저 받는다.
# 머리말은 화면의 것(web-headers.inc)을 붙인다. API 의 CSP(default-src 'none')로는 화면이 뜨지 못한다.

# 빌드가 이름에 해시를 붙인 파일(Vite 의 assets). 없는 파일은 화면으로 돌리지 않고 404 다
location ^~ /assets/ {
    root /usr/share/nginx/web;
    try_files $uri @web_not_found;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Request-ID $request_id always;
    include /etc/nginx/conf.d/web-headers.inc;
}

# 그 밖의 모든 주소. 있는 파일(favicon.svg 등)이면 그것, 없으면 index.html
location / {
    root /usr/share/nginx/web;
    try_files $uri /index.html;
    add_header Cache-Control "no-cache" always;
    add_header X-Request-ID $request_id always;
    include /etc/nginx/conf.d/web-headers.inc;
}

location @web_not_found {
    allow all;
    types { }
    default_type application/json;
    add_header X-Request-ID $request_id always;
    include /etc/nginx/conf.d/security-headers.inc;
    return 404 '{"detail":"찾을 수 없습니다."}';
}
