# docker/nginx/templates/web-headers.inc.template
# 화면(web.inc.template)의 응답에 붙이는 보안 머리말. API 의 것(security-headers.inc.template)과 CSP 만 다르다.
#
# 이미지가 뜰 때 이 파일도 ${이름} 을 바꿔 /etc/nginx/conf.d/web-headers.inc 로 쓴다(바꿀 것은 없다).
# location 에 add_header 가 하나라도 있으면 server 의 것을 모두 버리므로, 화면의 location 이 이것을 include 한다.
#
# CSP 의 시작값(2026-10-22, docs/product/screens.md 의 "시작할 때 정한 것"):
#   default-src 'self'     스크립트, 스타일, 연결(SSE 포함), 그림, 글꼴은 같은 출처만. 바깥의 CDN 과 글꼴을 부르지 않는다
#   object-src 'none'      플러그인을 막는다
#   base-uri 'self'        <base> 로 상대 주소를 다른 곳으로 돌리지 못한다
#   frame-ancestors 'none' 다른 사이트의 iframe 에 들어가지 못한다(클릭재킹)
# 인라인 스크립트는 쓰지 않는다('unsafe-inline' 이 없다). 빌드한 index.html 에도 인라인 스크립트가 없다.
# 제작자가 꾸민 소개(HTML)를 그리는 법은 소개 화면(C2, D1)을 만들 때 정한다. 샌드박스 iframe 이 후보다.
add_header X-Content-Type-Options "nosniff" always;
add_header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
add_header Referrer-Policy "no-referrer" always;
add_header Strict-Transport-Security $hsts always;
