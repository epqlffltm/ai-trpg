# docker/nginx/templates/default.conf.template
# 서버들 앞에 서는 프록시(nginx)의 로컬 설정. docker-compose.yml 의 proxy 가 쓴다. HTTP(8080) 하나만 듣는다.
# staging 에서는 docker-compose.staging.yml 이 이 파일 자리에 docker/nginx/staging/default.conf.template 을 붙인다(TLS, 허용 주소).
#
# 이미지(nginx-unprivileged)는 뜰 때 templates 폴더의 *.template 의 ${이름} 을 환경 변수로 바꿔 /etc/nginx/conf.d/ 에 쓴다.
# 바꾸는 것은 컨테이너에 있는 환경 변수의 이름뿐이다(APP_ENVIRONMENT, APP_VERSION). nginx 의 변수는 소문자로 적어
# 환경 변수와 겹치지 않게 한다. ${log_millis} 처럼 중괄호가 필요한 nginx 의 변수도 그래서 그대로 남는다.
#
# 나눈 파일(끝이 .conf 가 아니라 nginx 가 저절로 읽지 않는다. include 한 곳에서만 쓰인다):
#   http.inc              주소 찾기, 요청 수 제한의 구역, 로그의 모양, HSTS 의 값(http 단계)
#   api.inc               API 를 받는 server 의 몸통. 어느 주소를 어느 서버로 보내고 무엇을 막는지
#   security-headers.inc  모든 응답에 붙이는 보안 머리말

include /etc/nginx/conf.d/http.inc;

server {
    listen 8080;
    server_name _;

    include /etc/nginx/conf.d/api.inc;
}

# 컨테이너의 상태 확인(compose 의 healthcheck). 컨테이너 안에서만 열리는 포트라 바깥에서는 부를 수 없다
server {
    listen 127.0.0.1:8081;
    access_log off;
    location = /health {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }
}
