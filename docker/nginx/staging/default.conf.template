# docker/nginx/staging/default.conf.template
# staging(VM)의 프록시 설정(#451). docker-compose.staging.yml 이 로컬의 docker/nginx/templates/default.conf.template 자리에 붙인다.
# 몸통(api.inc)과 http 단계(http.inc), 보안 머리말은 로컬과 같은 파일을 쓴다. 이 파일은 듣는 포트, TLS, 허용 주소만 정한다.
#
#   8080  HTTP. compose 가 VM 의 80 에 잇는다. Let's Encrypt 의 확인(/.well-known/acme-challenge/)만 답하고 나머지는 HTTPS 로 넘긴다(301)
#   8443  HTTPS. compose 가 VM 의 443 에 잇는다. TLS 를 여기서 끝낸다. 허용 주소에서 온 요청만 서버에 넘긴다
#   8081  컨테이너 안의 상태 확인(compose 의 healthcheck). 바깥에서는 부를 수 없다
#
# 이미지(nginx-unprivileged)는 root 가 아니라서 1024 아래의 포트를 열지 못한다. 그래서 80, 443 이 아니라 8080, 8443 을 듣는다.
# ${DOMAIN} 은 이미지가 뜰 때 compose 의 환경 변수로 바뀐다(루트 .env 의 DOMAIN).
#
# 허용 주소(운영자 혼자 쓰는 동안 남이 들어오지 못하게):
#   /etc/nginx/allowlist/*.conf 의 allow 줄에 있는 주소만 서버에 닿는다. 그 밖은 403 이다.
#   파일은 VM 의 docker/nginx/allowlist/ 에 둔다(git 에 올리지 않는다. 보기는 allow.conf.example).
#   파일이 하나도 없으면 아무도 닿지 못한다(닫힌 쪽으로 실패한다). 바꾸면 1분 안에 nginx 가 다시 읽는다(docker/nginx/staging/start.sh).
#   막는 것은 서버에 넘기는 주소다. nginx 가 직접 답하는 404(관리자 화면, 서버끼리의 주소 등)는 허용 주소와 상관없이 404 다.
#   가동 확인(/healthz)은 모두에게 연다. 바깥의 감시가 "VM 과 nginx 가 살아 있는가"와 인증서를 본다. 서버의 상태는 싣지 않는다

include /etc/nginx/conf.d/http.inc;

# --- HTTP: 인증서의 확인과 넘기기 ---
server {
    listen 8080;
    server_name _;
    server_tokens off;

    access_log /dev/stdout proxy_json;
    error_log /dev/stderr crit;
    set $proxy_upstream proxy;
    include /etc/nginx/conf.d/security-headers.inc;

    # Let's Encrypt 가 HTTP-01 로 이 도메인의 주인인지 확인하는 자리. certbot 이 이 폴더에 파일을 두고 지운다.
    # 허용 주소를 걸지 않는다. Let's Encrypt 는 여러 곳에서 확인하러 온다
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    # 받은 Host 가 아니라 정한 도메인으로 넘긴다. 남의 도메인으로 넘기는 데 쓰이지 않는다
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# --- HTTPS: TLS 를 끝내고 서버에 넘긴다 ---
server {
    listen 8443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # certbot 이 받은 인증서를 nginx 의 사용자(101)가 읽을 수 있게 옮겨 둔 것(docker/certbot/deploy-hook.sh)
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    # Mozilla 의 intermediate 권고. TLS 1.0, 1.1 은 받지 않는다. 1.3 의 암호는 nginx 가 고른다
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # OCSP stapling 은 켜지 않는다. Let's Encrypt 가 OCSP 를 끝냈다

    # 허용 주소. allow 줄이 하나도 없으면 아래의 deny all 만 남아 모두 403 이다
    include /etc/nginx/allowlist/*.conf;
    deny all;
    error_page 403 @forbidden;

    # 가동 확인. 허용 주소 밖에서도 답한다. 바깥의 감시가 1분마다 부르므로 로그를 남기지 않는다
    location = /healthz {
        allow all;
        access_log off;
        add_header X-Request-ID $request_id always;
        include /etc/nginx/conf.d/security-headers.inc;
        return 200 '{"status":"ok"}';
    }

    location @forbidden {
        allow all;
        add_header X-Request-ID $request_id always;
        include /etc/nginx/conf.d/security-headers.inc;
        return 403 '{"detail":"허용된 주소에서만 쓸 수 있습니다."}';
    }

    include /etc/nginx/conf.d/api.inc;
}

# 컨테이너의 상태 확인(compose 의 healthcheck). 컨테이너 안에서만 열리는 포트라 바깥에서는 부를 수 없다
server {
    listen 127.0.0.1:8081;
    access_log off;
    location = /health {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }
}
