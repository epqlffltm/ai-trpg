# .env.example
# docker compose 가 읽는 인프라 설정. 서버의 설정은 각 서버 폴더의 .env 에 따로 둔다.
# 복사해서 .env 를 만들고 값을 채운다. .env 는 커밋하지 않는다.
#
#   cp .env.example .env

# --- PostgreSQL ---
# 관리용 슈퍼유저. 서버는 이 계정으로 접속하지 않는다
POSTGRES_USER=trpg
# 비워 두면 docker compose 가 기동을 거부한다
POSTGRES_PASSWORD=
POSTGRES_DB=trpg
# 호스트 쪽 포트. Windows 에서 Hyper-V 가 예약한 구간이면 다른 값으로 바꾼다
#   netsh interface ipv4 show excludedportrange protocol=tcp
POSTGRES_PORT=5432

# 인증 서버 전용 계정(auth)의 비밀번호.
# auth-server/.env 의 DATABASE_URL 에 같은 값을 적는다.
# 볼륨이 비어 있는 첫 기동 때만 반영된다
AUTH_DB_PASSWORD=

# 인증 서버 계정에 테스트용 DB 를 만들 권한(CREATEDB)을 줄지. 인증 서버의 테스트(manage.py test)가
# 테스트용 DB 를 만들고 지운다. 개발 PC 에서는 true, 운영에서는 이 줄을 지운다(주지 않는다).
# 볼륨이 비어 있는 첫 기동 때만 반영된다
AUTH_DB_ALLOW_TEST_DB=true

# --- DB 의 백업(docker-compose.yml 의 db-backup) ---
# 백업 파일을 두는 PC 의 폴더. 적지 않으면 저장소의 ./backups 다(git 에 올라가지 않는다).
# 다른 디스크를 쓰려면 그 경로를 적는다. Windows 는 D:/ai-trpg-backups 처럼 빗금(/)으로 적는다
# BACKUP_DIR=./backups
# 남기는 백업의 수. 하루에 하나씩 뜨므로 14 면 2주다
# BACKUP_KEEP=14

# --- Redis ---
REDIS_PORT=6379

# 게임 서버 전용 계정(game)의 비밀번호.
# game-server/.env 의 DATABASE_URL 에 같은 값을 적는다.
# 볼륨이 비어 있는 첫 기동 때만 반영된다
GAME_DB_PASSWORD=

# 결제 서버 전용 계정(billing)의 비밀번호.
# billing-server/.env 의 DATABASE_URL 에 같은 값을 적는다.
# 볼륨이 비어 있는 첫 기동 때만 반영된다
BILLING_DB_PASSWORD=

# 게시판 서버 전용 계정(board)의 비밀번호.
# board-server/.env 의 DATABASE_URL 에 같은 값을 적는다.
# 볼륨이 비어 있는 첫 기동 때만 반영된다
BOARD_DB_PASSWORD=

# 알림 서버 전용 계정(notification)의 비밀번호.
# notification-server/.env 의 DATABASE_URL 에 같은 값을 적는다.
# 볼륨이 비어 있는 첫 기동 때만 반영된다
NOTIFICATION_DB_PASSWORD=

# --- 서버 넷을 컨테이너로 띄울 때(docker compose --profile app) ---
# 적지 않아도 된다. 서버를 PC 에서 직접 띄울 때는 읽지 않는다.
# 게임 서버가 부르는 언어 모델의 주소. 적지 않으면 이 PC 의 Ollama 다(컨테이너 안에서 host.docker.internal)
# GAME_LLM_BASE_URL=http://host.docker.internal:11434/v1
# 이 PC 에서 여는 포트. 다른 프로그램과 겹칠 때만 바꾼다
# 프록시(nginx). 바깥에서 들어오는 길이다
# PROXY_PORT=8080
# 인증 서버. 관리자 화면(/admin/)을 여는 데만 쓴다. 프록시는 관리자 화면을 막는다
# AUTH_PORT=8000
# 프록시의 로그에 실리는 환경의 이름과 버전. 서버들의 APP_ENVIRONMENT, APP_VERSION 과 같은 뜻이다
# APP_ENVIRONMENT=development
# APP_VERSION=dev

# --- 로그와 메트릭 모으기(docker compose --profile observability, #25) ---
# 이 프로필을 켤 때만 읽는다. 켜지 않으면 적지 않아도 된다.
# Grafana 의 관리자(admin) 비밀번호. 비어 있으면 Grafana 가 뜨지 않는다.
# 볼륨(grafanadata)이 비어 있는 첫 기동 때만 반영된다. 바꾸는 법은 README 의 "로그와 메트릭 모으기"에 있다
GRAFANA_ADMIN_PASSWORD=
# 이 PC 에서 Grafana 를 여는 포트. 다른 프로그램과 겹칠 때만 바꾼다
# GRAFANA_PORT=3000
