# .env.example
# docker compose 가 읽는 인프라 설정. 서버의 설정은 각 서버 폴더의 .env 에 따로 둔다.
# .env 는 커밋하지 않는다.
#
# 일곱 개의 .env(이 파일과 서버 여섯)를 한 번에 만들고 비밀번호와 비밀을 난수로 채운다. 저장소 루트에서:
#   uv run --no-project python tools/fill_env.py
# 이미 적힌 값은 바꾸지 않는다. 두 파일이 함께 아는 값(DB 비밀번호와 서버의 DATABASE_URL 등)은 같은 값으로 맞춘다.
# 예전에 만든 .env 에 없는 줄(이 파일에 나중에 생긴 것)은 설명과 함께 주석으로 막아 끝에 더한다.
# 손으로 만들려면 복사해서 값을 채운다:  cp .env.example .env

# --- PostgreSQL ---
# 관리용 슈퍼유저의 이름. 서버는 이 계정으로 접속하지 않는다. 초기화 스크립트와 백업만 쓴다
POSTGRES_USER=trpg
# 관리용 슈퍼유저의 비밀번호. 비워 두면 docker compose 가 기동을 거부한다.
# 볼륨(pgdata)이 비어 있는 첫 기동 때만 반영된다. 그 뒤에 바꾸면 DB 의 계정과 어긋난다
POSTGRES_PASSWORD=
# 서버들이 함께 쓰는 DB 의 이름. 서버마다 스키마를 나눠 쓴다(auth, game, billing …)
POSTGRES_DB=trpg
# 이 PC 에서 DB 를 여는 포트. PC 에서 직접 띄운 서버가 붙는 곳이다. Windows 에서 Hyper-V 가 예약한 구간이면 다른 값으로 바꾼다
#   netsh interface ipv4 show excludedportrange protocol=tcp
POSTGRES_PORT=5432

# 인증 서버 전용 계정(auth)의 비밀번호.
# auth-server/.env 의 DATABASE_URL 에 같은 값을 적는다(tools/fill_env.py 가 맞춘다).
# 볼륨이 비어 있는 첫 기동 때만 반영된다
AUTH_DB_PASSWORD=

# 인증 서버 계정에 테스트용 DB 를 만들 권한(CREATEDB)을 줄지. 인증 서버의 테스트(manage.py test)가
# 테스트용 DB 를 만들고 지운다. 개발 PC 에서는 true, 운영에서는 이 줄을 지운다(주지 않는다).
# 볼륨이 비어 있는 첫 기동 때만 반영된다
AUTH_DB_ALLOW_TEST_DB=true

# --- DB 의 백업(docker-compose.yml 의 db-backup) ---
# 백업 파일을 두는 PC 의 폴더. 적지 않으면 저장소의 ./backups 다(git 에 올라가지 않는다).
# 다른 디스크를 쓰려면 그 경로를 적는다. Windows 는 D:/ai-trpg-backups 처럼 빗금(/)으로 적는다
# BACKUP_DIR=./backups
# 남기는 백업의 수. 하루에 하나씩 뜨므로 14 면 2주다
# BACKUP_KEEP=14

# --- Redis ---
# 이 PC 에서 Redis 를 여는 포트. 시도 횟수 제한과 IP 차단의 기록이 들어간다. 비밀번호는 없다(이 PC 에만 연다)
REDIS_PORT=6379

# --- 그림 저장소(docker-compose.yml 의 object-store, #540) ---
# 그림 파일(배경, 캐릭터, 일러스트)을 두는 S3 의 로컬 흉내(SeaweedFS). 서명한 요청만 받는다.
# staging 은 진짜 S3(서울)를 쓰고 이것을 띄우지 않는다(docs/architecture/deployment.md 의 "그림 저장소").
# 비밀 키. 비워 두면 docker compose 가 기동을 거부한다. tools/fill_env.py 가 난수로 채운다.
# 이 키 하나가 저장소의 모든 그림을 읽고 쓰고 지운다
IMAGE_STORE_SECRET_ACCESS_KEY=
# 접근 키의 이름. 비밀이 아니다. 적지 않으면 ai-trpg-local
# IMAGE_STORE_ACCESS_KEY_ID=ai-trpg-local
# 뜰 때 만드는 버킷. 적지 않으면 ai-trpg-images. 백업의 버킷과 나눈다
# IMAGE_STORE_BUCKET=ai-trpg-images
# 이 PC 에서 S3 를 여는 포트. Windows 에서 Hyper-V 가 예약한 구간이면 다른 값으로 바꾼다
# IMAGE_STORE_PORT=8333

# 게임 서버 전용 계정(game)의 비밀번호.
# trpg-server/.env 의 DATABASE_URL 에 같은 값을 적는다(tools/fill_env.py 가 맞춘다).
# 볼륨이 비어 있는 첫 기동 때만 반영된다
GAME_DB_PASSWORD=

# 결제 서버 전용 계정(billing)의 비밀번호.
# billing-server/.env 의 DATABASE_URL 에 같은 값을 적는다(tools/fill_env.py 가 맞춘다).
# 볼륨이 비어 있는 첫 기동 때만 반영된다
BILLING_DB_PASSWORD=

# 게시판 서버 전용 계정(board)의 비밀번호.
# board-server/.env 의 DATABASE_URL 에 같은 값을 적는다(tools/fill_env.py 가 맞춘다).
# 볼륨이 비어 있는 첫 기동 때만 반영된다
BOARD_DB_PASSWORD=

# 알림 서버 전용 계정(notification)의 비밀번호.
# notification-server/.env 의 DATABASE_URL 에 같은 값을 적는다(tools/fill_env.py 가 맞춘다).
# 볼륨이 비어 있는 첫 기동 때만 반영된다
NOTIFICATION_DB_PASSWORD=

# asset 서버 전용 계정(asset)의 비밀번호.
# asset-server/.env 의 DATABASE_URL 에 같은 값을 적는다(tools/fill_env.py 가 맞춘다).
# 볼륨이 비어 있는 첫 기동 때만 반영된다. 이미 있는 볼륨에서는 asset-server/README.md 대로 계정을 직접 만든다
ASSET_DB_PASSWORD=

# --- 서버 넷을 컨테이너로 띄울 때(docker compose --profile app) ---
# 아래는 적지 않아도 된다. 서버를 PC 에서 직접 띄울 때는 읽지 않는다.
# 게임 서버가 부르는 언어 모델의 주소. 적지 않으면 이 PC 의 Ollama 다(컨테이너 안에서 host.docker.internal)
# GAME_LLM_BASE_URL=http://host.docker.internal:11434/v1
# 프록시(nginx)를 이 PC 에서 여는 포트. 바깥에서 들어오는 길이다. 다른 프로그램과 겹칠 때만 바꾼다
# PROXY_PORT=8080
# 인증 서버를 이 PC 에서 여는 포트. 관리자 화면(/admin/)을 여는 데만 쓴다. 프록시는 관리자 화면을 막는다
# AUTH_PORT=8000
# 프록시의 로그에 실리는 환경의 이름. 서버들의 APP_ENVIRONMENT 와 같은 뜻이다
# APP_ENVIRONMENT=development
# 프록시의 로그에 실리는 버전. 서버들의 APP_VERSION 과 같은 뜻이다
# APP_VERSION=dev

# --- 로그와 메트릭 모으기(docker compose --profile observability, #25) ---
# 이 프로필을 켤 때만 읽는다. 켜지 않으면 적지 않아도 된다.
# Grafana 의 관리자(admin) 비밀번호. 비어 있으면 Grafana 가 뜨지 않는다.
# 볼륨(grafanadata)이 비어 있는 첫 기동 때만 반영된다. 바꾸는 법은 README 의 "로그와 메트릭 모으기"에 있다
GRAFANA_ADMIN_PASSWORD=
# 이 PC 에서 Grafana 를 여는 포트. 다른 프로그램과 겹칠 때만 바꾼다
# GRAFANA_PORT=3000
# DB 의 메트릭을 읽는 계정(monitor)의 비밀번호. 통계만 읽고 표는 읽지 못한다(docker/postgres/init/07-monitor-role.sql).
# 주소(postgresql://monitor:<비밀번호>@db…)에 그대로 들어가므로 영문과 숫자로만 짓는다(tools/fill_env.py 는 16진수로 만든다).
# 볼륨(pgdata)이 비어 있는 첫 기동 때만 계정이 만들어진다. 이미 있는 볼륨에서 만드는 법은 README 의 "로그와 메트릭 모으기"에 있다
MONITOR_DB_PASSWORD=
# 서버가 메트릭을 OTLP 로 미는 곳(Alloy). observability 프로필을 켤 때만 적는다.
# 적지 않으면 서버는 메트릭을 내보내지 않는다. app 프로필만 켠 채로 적으면 없는 Alloy 로 보내며 경고를 남긴다
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318

# --- 경보(Alertmanager, docker/alertmanager) ---
# 경보 규칙(docker/prometheus/rules)이 울린 것을 보내는 곳. 적은 것만 켠다. 하나도 없으면 경보는 Grafana 의 Alerting 화면에서만 본다.
# 넷 다 적어도 된다. 같은 경보가 넷에 함께 간다. 바깥 서비스가 내주는 값이라 tools/fill_env.py 가 만들지 않는다.
# 만드는 법은 README 의 "로그와 메트릭 모으기"에 있다
# Discord 채널의 웹후크 주소(채널 설정 > 연동 > 웹후크). 비밀값이다. 아는 사람은 누구나 그 채널에 글을 쓴다
# ALERT_DISCORD_WEBHOOK_URL=
# Slack 의 Incoming Webhook 주소(https://hooks.slack.com/services/…). 비밀값이다. 채널은 웹후크를 만들 때 정한다
# ALERT_SLACK_WEBHOOK_URL=
# Telegram 봇의 토큰(@BotFather 가 내준다). 비밀값이다. 아래의 CHAT_ID 와 함께 적는다
# ALERT_TELEGRAM_BOT_TOKEN=
# 경보를 받을 Telegram 대화의 번호. 숫자다(그룹은 -100 으로 시작한다). 비밀이 아니다
# ALERT_TELEGRAM_CHAT_ID=
# 경보 메일을 보낼 계정. Gmail 은 그 주소다. 아래의 SMTP_PASSWORD 와 함께 적는다. 보내는 사람도 이 주소다
# ALERT_SMTP_USER=
# 그 계정의 앱 비밀번호. 비밀값이다. 서버들이 사용자에게 보내는 메일(auth-server 의 SMTP_PASSWORD)과 다른 것을 만들어 쓴다.
# 하나가 새면 그것만 지운다. https://myaccount.google.com/apppasswords
# ALERT_SMTP_PASSWORD=
# 메일 서버의 주소와 포트(STARTTLS). 적지 않으면 Gmail(smtp.gmail.com:587)이다
# ALERT_SMTP_SMARTHOST=smtp.gmail.com:587
# 경보 메일을 받을 주소. 쉼표로 여럿을 적는다. 적지 않으면 ALERT_SMTP_USER 다
# ALERT_EMAIL_TO=
# 바깥 감시의 주소(healthchecks.io 의 ping 주소 https://hc-ping.com/… 등). 비밀값이다.
# 늘 울리는 경보(Watchdog)를 1~2분마다 이 주소로만 보낸다. 끊기면 바깥 감시가 그 서비스의 알림으로 알린다.
# Prometheus, Alertmanager, PC 나 VM 이 통째로 죽은 것은 위의 받는 곳으로는 알 수 없어서다. 만드는 법은 README 의 "로그와 메트릭 모으기"에 있다
# ALERT_HEARTBEAT_WEBHOOK_URL=

# --- staging(VM, docker-compose.staging.yml, #451) ---
# VM 의 .env 에만 적는다. 이 PC 에서는 적지 않는다(적으면 로컬의 compose 가 staging 의 설정을 읽는다).
# 자세한 것은 docs/architecture/deployment.md
#
# compose 가 읽는 파일 둘. 적어 두면 명령마다 -f 를 붙이지 않는다
# COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml
# compose 가 켜는 프로필. 적어 두면 명령마다 --profile 을 붙이지 않는다
# COMPOSE_PROFILES=app,observability
# 이 VM 의 도메인. 인증서, HTTPS 로 넘기기, 인증 서버의 ALLOWED_HOSTS 와 refresh 쿠키의 출처에 쓴다
# DOMAIN=
# Let's Encrypt 에 알리는 주소(인증서를 받을 계정을 만들 때 쓴다)
# ACME_EMAIL=
# 게임 서버의 로컬 모델. 집 PC 의 Ollama 를 사설망(Tailscale)으로 부른다. staging 에서는 꼭 적는다
# GAME_LLM_BASE_URL=http://<집 PC 의 Tailscale 주소>:11434/v1
# staging 은 observability 를 켜므로 메트릭을 보낼 곳(위의 OTEL_EXPORTER_OTLP_ENDPOINT)도 적는다
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# 바깥 백업(backup-offsite)이 덤프를 올리는 S3 버킷의 이름. 덤프를 age 로 잠가 올리고 주마다 풀어 본다
# (docs/architecture/deployment.md 의 "백업")
# BACKUP_S3_BUCKET=
# 그 버킷의 지역. 적지 않으면 서울(ap-northeast-2)이다
# BACKUP_S3_REGION=ap-northeast-2
# 올리기, 받기, 목록만 할 수 있는 IAM 사용자의 접근 키 ID(docker/backup-offsite/iam-policy.json). 지우는 권한이 없다
# BACKUP_AWS_ACCESS_KEY_ID=
# 그 IAM 사용자의 비밀 접근 키. 비밀값이다. AWS 가 내주는 값이라 tools/fill_env.py 가 만들지 않는다
# BACKUP_AWS_SECRET_ACCESS_KEY=
# age 의 공개키 둘을 빈칸으로 잇는다: 주 열쇠(비밀키는 VM 밖에만) 확인 열쇠(비밀키는 backup-keys/check.key). 비밀이 아니다
# BACKUP_AGE_RECIPIENTS=age1... age1...
# 로그의 environment. docker-compose.staging.yml 이 모든 서버와 프록시에 staging 을 주므로 적지 않아도 된다
# APP_ENVIRONMENT=staging
