__pycache__/
*.py[cod]
.venv/
.env
db.sqlite3
.vscode/
.idea/
# 서명용 개인키. 저장소에 올라가면 누구나 토큰을 만들 수 있다
*.pem
keys/
trpg_key.txt

# DB 의 백업(docker-compose.yml 의 db-backup). 이메일, 비밀번호 해시, 결제 원장이 들어 있다
/backups/

# 커버리지를 잴 때 생기는 파일(파이썬의 coverage, Go 의 coverprofile)
.coverage
.coverage.*
htmlcov/
coverage.out

# staging 의 허용 주소(docker/nginx/allowlist/allow.conf.example). 운영자 집의 공인 IP 가 들어 있다
/docker/nginx/allowlist/*.conf

# 바깥 백업의 확인 열쇠(docker-compose.staging.yml 의 backup-offsite). 이 열쇠로 버킷의 백업이 풀린다
/backup-keys/
