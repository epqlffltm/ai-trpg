# chat-server/.env.example
# chat 서버 설정. chat-server/.env 를 만들고 값을 채운다. .env 는 커밋하지 않는다. 다른 서버의 .env 와 따로 둔다.
#
# 비밀(DB 비밀번호, ASSET_SECRET, BILLING_SECRET)은 저장소 루트에서 이 명령이 채운다. asset 서버, 결제 서버의 짝과 같은 값으로 맞춘다
#   uv run --no-project python tools/fill_env.py
# 손으로 만들려면 복사해서 값을 채운다:  cp .env.example .env

# 개발용 기능(API 문서 화면)을 켠다. 운영에서는 적지 않거나 false 로 둔다
DEBUG=true

# DB 접속 주소. 비밀번호는 루트 .env 의 CHAT_DB_PASSWORD 와 같은 값이다.
# 포트는 루트 .env 의 POSTGRES_PORT 다. 비동기 드라이버라 postgresql+asyncpg:// 로 시작한다
DATABASE_URL=postgresql+asyncpg://chat:여기에비밀번호@127.0.0.1:5432/trpg

# 인증 서버가 공개키를 내주는 주소. 이 주소에서 받은 키로 서명된 토큰을 믿는다.
# 끊긴 세션의 목록은 그 옆(…/session-revocations)에서 받는다
AUTH_JWKS_URL=http://127.0.0.1:8000/api/v1/auth/jwks

# span 과 메트릭을 OTLP(HTTP)로 미는 수집기(Alloy)의 주소. 경로 없이 적는다. 적지 않으면 내보내지 않는다(README 의 "추적", "메트릭").
# PC 에서 직접 띄울 때는 적지 않는다. compose 는 루트 .env 의 같은 이름을 넘긴다
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# 메트릭을 보내는 간격(밀리초). 1000 이상. 적지 않으면 15000 이다
# OTEL_METRIC_EXPORT_INTERVAL=15000

# --- 캐릭터의 판과 페르소나(asset 서버) ---
# 대화를 시작할 때 asset 서버에서 가져온다. 적지 않으면 대화를 시작하지 못한다(503). 진행 중인 대화는 사본으로 돈다.
# asset 서버의 주소
ASSET_URL=http://127.0.0.1:8006
# asset 서버를 부를 때 서명하는 비밀. asset-server/.env 의 CHAT_SERVER_SECRET 과 같은 값이다. 32자 이상. 비밀값이다.
# tools/fill_env.py 가 두 파일에 같은 값을 채우고 주석을 푼다
# ASSET_SECRET=

# --- 말 한 번의 값(결제 서버) ---
# 모델의 값을 가격 목록에서 읽고, 말 한 번에 홀드를 건다. 적지 않으면 받지 않는다(모델은 값 없이 보이고 말은 공짜다).
# compose 로 띄우면 compose 가 결제 서버의 주소를 준다
# BILLING_URL=http://127.0.0.1:8003
# 결제 서버를 부를 때 서명하는 비밀. billing-server/.env 의 CHAT_SERVER_SECRET 과 같은 값이다. 32자 이상. 비밀값이다.
# tools/fill_env.py 가 두 파일에 같은 값을 채우고 주석을 푼다
# BILLING_SECRET=

# --- 알림(알림 서버, #678) ---
# 신고 처리를 알림 서버에 넣을 때 서명하는 비밀. notification-server/.env 의 CHAT_SERVER_SECRET 과 같은 값이다.
# 32자 이상. 비밀값이다. tools/fill_env.py 가 두 파일에 같은 값을 채우고 주석을 푼다.
# compose 는 NOTIFICATION_URL 을 넘기므로 compose 로 띄우면 이 값이 있어야 뜬다
# NOTIFICATION_SECRET=
# 알림 서버의 주소. 비우면 발송함에 적기만 하고 보내지 않는다(compose 는 http://notification-server:8004 를 넘긴다)
# NOTIFICATION_URL=http://127.0.0.1:8004
# 알림 서버를 부를 때 기다리는 시간(초)
# NOTIFICATION_TIMEOUT_SECONDS=5

# --- 탈퇴(인증 서버, #670) ---
# 인증 서버가 탈퇴를 알리는 요청의 서명 비밀. auth-server/.env 의 CHAT_SECRET 과 같은 값이다. 32자 이상. 비밀값이다.
# 비워 두면 탈퇴 알림을 받지 않는다(401). 인증 서버는 받을 때까지 다시 보낸다.
# tools/fill_env.py 가 두 파일에 같은 값을 채우고 주석을 푼다
# AUTH_SERVER_SECRET=

# --- 말 한 번(모델) ---
# 모델 목록의 창구마다 키. 비밀값이다. 비우면 그 창구의 모델로 말을 보내면 503 provider_unavailable 이다.
# 공급자가 내주는 값이라 tools/fill_env.py 가 만들지 않는다. 게임 서버와 다른 키(월 사용 한도를 따로 거는 키)를 권한다
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# ZAI_API_KEY=
# DEEPINFRA_API_KEY=
# 창구의 주소. 바꿀 일이 거의 없다(OPENAI_BASE_URL, ANTHROPIC_BASE_URL, GEMINI_BASE_URL, ZAI_BASE_URL, DEEPINFRA_BASE_URL)
# 모델을 한 번 부르는 시간의 상한(초, 600 까지)
# LLM_TIMEOUT_SECONDS=120
# 말 한 번의 답의 길이의 상한(토큰). 가격표의 출력 단계(o0)가 약속하는 길이다
# CHAT_OUTPUT_LIMIT=1024
# 모델에 보내는 지난 말의 양의 상한(글자). 가격표의 입력 단계(i0)가 약속하는 양이다
# CHAT_CONTEXT_CHARS=12000
# 글의 다양함(0~2)
# CHAT_TEMPERATURE=0.9
# 다음 답 추천. 답 끝에 선택지 셋을 함께 받는다. 끄면 받지 않는다
# CHAT_SUGGESTIONS=true
# 굴리는 요약의 모델(모델 목록의 이름표). 싼 모델을 쓴다. 비우면 요약하지 않는다
# SUMMARY_MODEL=
# 창 밖으로 밀려난 말이 이만큼 쌓이면 요약한다
# SUMMARY_AFTER_MESSAGES=8
# 로어북의 뜻으로 찾기. off 면 상시와 키워드만 쓴다. llm 이면 임베딩 모델을 부른다(trpg-server 와 같은 이름, 같은 Ollama)
# EMBEDDER=off
# EMBEDDING_MODEL=bge-m3
# 임베딩 모델의 주소. /embeddings 앞까지(로컬 Ollama 면 http://localhost:11434/v1)
# EMBEDDING_BASE_URL=
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_DIMENSIONS=
# 요청 수 제한을 세는 Redis(redis://localhost:6379/2). 비우면 서버 안의 메모리로 센다(서버가 하나일 때만 맞다)
# REDIS_URL=
# 모델을 부르는 요청은 한 사람이 60초에 20번까지, 쓰기는 60초에 120번까지
# GENERATION_LIMIT=20
# GENERATION_WINDOW_SECONDS=60
# WRITE_LIMIT=120
# WRITE_WINDOW_SECONDS=60
