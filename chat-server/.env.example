# chat-server/.env.example
# chat 서버 설정. chat-server/.env 를 만들고 값을 채운다. .env 는 커밋하지 않는다. 다른 서버의 .env 와 따로 둔다.
#
# 비밀(DB 비밀번호, ASSET_SECRET)은 저장소 루트에서 이 명령이 채운다. asset 서버의 짝과 같은 값으로 맞춘다
#   uv run --no-project python tools/fill_env.py
# 손으로 만들려면 복사해서 값을 채운다:  cp .env.example .env

# 개발용 기능(API 문서 화면)을 켠다. 운영에서는 적지 않거나 false 로 둔다
DEBUG=true

# DB 접속 주소. 비밀번호는 루트 .env 의 CHAT_DB_PASSWORD 와 같은 값이다.
# 포트는 루트 .env 의 POSTGRES_PORT 다. 비동기 드라이버라 postgresql+asyncpg:// 로 시작한다
DATABASE_URL=postgresql+asyncpg://chat:여기에비밀번호@127.0.0.1:5432/trpg

# 인증 서버가 공개키를 내주는 주소. 이 주소에서 받은 키로 서명된 토큰을 믿는다.
# 끊긴 세션의 목록은 그 옆(…/session-revocations)에서 받는다
AUTH_JWKS_URL=http://127.0.0.1:8000/api/v1/auth/jwks

# span 과 메트릭을 OTLP(HTTP)로 미는 수집기(Alloy)의 주소. 경로 없이 적는다. 적지 않으면 내보내지 않는다(README 의 "추적", "메트릭").
# PC 에서 직접 띄울 때는 적지 않는다. compose 는 루트 .env 의 같은 이름을 넘긴다
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# 메트릭을 보내는 간격(밀리초). 1000 이상. 적지 않으면 15000 이다
# OTEL_METRIC_EXPORT_INTERVAL=15000

# --- 캐릭터의 판과 페르소나(asset 서버) ---
# 대화를 시작할 때 asset 서버에서 가져온다. 적지 않으면 대화를 시작하지 못한다(503). 진행 중인 대화는 사본으로 돈다.
# asset 서버의 주소
ASSET_URL=http://127.0.0.1:8006
# asset 서버를 부를 때 서명하는 비밀. asset-server/.env 의 CHAT_SERVER_SECRET 과 같은 값이다. 32자 이상. 비밀값이다.
# tools/fill_env.py 가 두 파일에 같은 값을 채우고 주석을 푼다
# ASSET_SECRET=
