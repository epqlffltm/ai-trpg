# billing-server/.env.example
# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다.
# 인증 서버, 게임 서버의 .env 와 따로 둔다.

# 개발용 동작(등록한 주소 목록 같은 자세한 출력)을 켠다. 운영에서는 적지 않거나 false 로 둔다
DEBUG=true

# 결제 서버 전용 계정(billing)의 접속 주소. 비밀번호는 루트 .env 의 BILLING_DB_PASSWORD 와 같은 값이다.
# 파이썬 서버들과 달리 postgres:// 로 시작한다(드라이버 이름을 붙이지 않는다)
DATABASE_URL=postgres://billing:여기에비밀번호@127.0.0.1:5432/trpg

# 인증 서버가 공개키를 내주는 주소. 이 주소에서 받은 키로 서명된 토큰을 믿는다
AUTH_JWKS_URL=http://127.0.0.1:8000/api/v1/auth/jwks

# 인증 서버가 끊긴 세션의 목록을 내주는 주소. 적지 않으면 AUTH_JWKS_URL 옆(…/session-revocations)이다
# AUTH_SESSION_REVOCATIONS_URL=http://127.0.0.1:8000/api/v1/auth/session-revocations

# 가입을 마친 사용자가 한 번 받는 환영 크레딧(무료)의 양. 적지 않으면 1000 이다. 0 이면 주지 않는다
# WELCOME_CREDITS=1000

# 결제 대행사의 알림(웹훅)에 붙은 서명을 확인하는 비밀. 32자 이상이어야 한다.
# 아래 값은 일부러 짧다. 바꾸지 않으면 서버가 뜨지 않는다. 만들어 넣는 명령은 README 의 "설치와 실행"에 있다
PG_WEBHOOK_SECRET=바꿔야합니다

# 게임 서버가 보낸 요청의 서명을 확인하는 비밀. 32자 이상이고 위의 PG_WEBHOOK_SECRET 과 다른 값이어야 한다.
# 게임 서버가 이 서버를 부르게 되면 게임 서버의 .env 에도 같은 값을 적는다.
# 아래 값도 일부러 짧다. 바꾸지 않으면 서버가 뜨지 않는다. 만들어 넣는 명령은 README 의 "설치와 실행"에 있다
GAME_SERVER_SECRET=바꿔야합니다

# 인증 서버가 보낸 요청의 서명을 확인하는 비밀. 32자 이상이고 위의 두 비밀과 다른 값이어야 한다.
# auth-server/.env 의 BILLING_SECRET 과 같은 값이어야 한다. 두 파일에 함께 만들어 넣는 명령이 README 의 "설치와 실행"에 있다.
# 아래 값도 일부러 짧다. 바꾸지 않으면 서버가 뜨지 않는다
AUTH_SERVER_SECRET=바꿔야합니다

# 꽂을 결제 대행사. 적지 않으면 fake(정해 둔 대로 답하는 가짜)다. toss 면 토스페이먼츠의 테스트 모드다.
# toss 면 아래 두 키가 있어야 한다. 테스트 키(test_)만 받는다. 넣는 명령은 README 의 "주문과 결제" > "토스페이먼츠 테스트 모드"에 있다.
# 시크릿 키는 비밀이다. 화면에 찍지 않는 명령으로 넣는다. 클라이언트 키는 결제창에 실리는 공개된 값이다.
# DEBUG=true 이고 toss 면 개발용 결제 화면(http://127.0.0.1:8003/dev/checkout)이 열린다
# PAYMENT_PROVIDER=fake
# TOSS_SECRET_KEY=
# TOSS_CLIENT_KEY=

# 서버가 요청을 받는 주소. 적지 않으면 127.0.0.1:8003 이다.
# 인증 서버가 8000, 게임 서버가 8001, 게시판 서버가 8002 를 쓴다.
# Windows 에서 Hyper-V 가 그 포트를 예약했으면 PORT 를 다른 값으로 바꾼다
# HOST=127.0.0.1
# PORT=8003

# 테이블이 놓이는 스키마. 적지 않으면 billing 이다. 테스트는 이 값과 상관없이 billing_test 를 쓴다
# DB_SCHEMA=billing

# 크레딧을 쓸 때 무료 크레딧부터 쓰는지. 적지 않으면 true 다. false 면 산 크레딧부터 쓴다
# SPEND_FREE_FIRST=true

# 무료 크레딧이 지급된 뒤 사라질 때까지의 시간. 적지 않으면 168h(1주일)다. 168h, 30m, 90s 처럼 단위를 붙인다.
# 바꿔도 이미 지급한 것의 기한은 그대로다
# FREE_CREDIT_TTL=168h

# 홀드를 걸거나 연장한 뒤 만료될 때까지의 시간. 적지 않으면 24h 다. 1m 보다 짧게 둘 수 없다.
# 그 안에 게임 서버가 확정하거나 연장하지 않으면 정리 작업(cmd/sweeper)이 크레딧을 돌려준다
# HOLD_TTL=24h

# 주문을 만든 뒤 만료될 때까지의 시간. 적지 않으면 24h 다. 1m 보다 짧게 둘 수 없다.
# 그 안에 승인을 요청하지 않으면 주문은 expired 로 끝난다
# ORDER_TTL=24h

# 로그에 실리는 값들. 비밀값이 아니다. 규격은 저장소 루트의 docs/observability.md 에 있다.
# 이 서버가 도는 환경의 이름. 적지 않으면 development 다. 운영에서는 production 으로 적는다
# APP_ENVIRONMENT=development
# 배포한 코드의 버전. 적지 않으면 dev 다. 운영에서는 배포할 때 git SHA 나 이미지 태그를 넣는다
# APP_VERSION=dev
# 이 수준부터 로그를 남긴다. debug, info, warning, error 중 하나다. 적지 않으면 info 다
# LOG_LEVEL=info
