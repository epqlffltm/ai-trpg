# billing-server/.env.example
# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다.
# 인증 서버, 게임 서버의 .env 와 따로 둔다.

# 개발용 동작(등록한 주소 목록 같은 자세한 출력)을 켠다. 운영에서는 적지 않거나 false 로 둔다
DEBUG=true

# 결제 서버 전용 계정(billing)의 접속 주소. 비밀번호는 루트 .env 의 BILLING_DB_PASSWORD 와 같은 값이다.
# 파이썬 서버들과 달리 postgres:// 로 시작한다(드라이버 이름을 붙이지 않는다)
DATABASE_URL=postgres://billing:여기에비밀번호@127.0.0.1:5432/trpg

# 인증 서버가 공개키를 내주는 주소. 이 주소에서 받은 키로 서명된 토큰을 믿는다
AUTH_JWKS_URL=http://127.0.0.1:8000/api/v1/auth/jwks

# 사용자가 한 번 받는 환영 크레딧(무료)의 양. 적지 않으면 1000 이다. 0 이면 주지 않는다
# WELCOME_CREDITS=1000

# 결제 대행사의 알림(웹훅)에 붙은 서명을 확인하는 비밀. 32자 이상이어야 한다.
# 아래 값은 일부러 짧다. 바꾸지 않으면 서버가 뜨지 않는다. 만들어 넣는 명령은 README 의 "설치와 실행"에 있다
PG_WEBHOOK_SECRET=바꿔야합니다

# 서버가 요청을 받는 주소. 적지 않으면 127.0.0.1:8003 이다.
# 인증 서버가 8000, 게임 서버가 8001, 게시판 서버가 8002 를 쓴다.
# Windows 에서 Hyper-V 가 그 포트를 예약했으면 PORT 를 다른 값으로 바꾼다
# HOST=127.0.0.1
# PORT=8003

# 테이블이 놓이는 스키마. 적지 않으면 billing 이다. 테스트는 이 값과 상관없이 billing_test 를 쓴다
# DB_SCHEMA=billing

# 크레딧을 쓸 때 무료 크레딧부터 쓰는지. 적지 않으면 true 다. false 면 산 크레딧부터 쓴다
# SPEND_FREE_FIRST=true

# 무료 크레딧이 지급된 뒤 사라질 때까지의 시간. 적지 않으면 168h(1주일)다. 168h, 30m, 90s 처럼 단위를 붙인다.
# 바꿔도 이미 지급한 것의 기한은 그대로다
# FREE_CREDIT_TTL=168h
