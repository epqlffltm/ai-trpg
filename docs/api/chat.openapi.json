                "type": "null"
              }
            ]
          },
          "start": {
            "$ref": "#/components/schemas/StartOut"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "start",
          "character",
          "persona",
          "messages",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationDetail",
        "type": "object"
      },
      "ConversationPage": {
        "description": "목록의 한 쪽과 전체 개수. 게임 서버의 GET /tables 와 같은 모양이다(#593).",
