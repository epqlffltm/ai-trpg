            "type": "integer"
          },
          "gender": {
            "title": "Gender",
            "type": "string"
          },
          "greeting": {
            "title": "Greeting",
            "type": "string"
          },
          "image_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "intro_html": {
            "title": "Intro Html",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
