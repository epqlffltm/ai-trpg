            "title": "Speech Examples",
            "type": "string"
          },
          "starts": {
            "items": {
              "$ref": "#/components/schemas/StartDocument"
            },
            "title": "Starts",
            "type": "array"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "required": [
          "format",
          "name",
          "intro_html",
          "greeting",
          "speech_examples",
          "age",
          "gender",
          "tags",
          "starts",
          "image_id",
          "rating"
        ],
        "title": "CharacterDocument",
        "type": "object"
      },
      "CharacterOut": {
        "description": "대화 하나에 싣는 캐릭터. 가져온 판의 문서까지다.",
