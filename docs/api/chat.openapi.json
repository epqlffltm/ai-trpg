  "info": {
    "title": "AI TRPG chat 서버",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/chat/conversations": {
      "get": {
        "description": "내 대화의 목록. 최근에 말한 것부터다.",
        "operationId": "list_conversations_api_v1_chat_conversations_get",
        "parameters": [
          {
            "description": "asset 서버의 캐릭터 id. 주면 그 캐릭터의 대화만",
            "in": "query",
            "name": "character_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "asset 서버의 캐릭터 id. 주면 그 캐릭터의 대화만",
              "title": "Character Id"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Conversations",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      },
      "post": {
        "description": "대화를 시작한다. 캐릭터의 마지막 판과 페르소나를 가져와 고정한다.",
        "operationId": "start_conversation_api_v1_chat_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Start Conversation",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/chat/conversations/{conversation_id}": {
      "delete": {
        "description": "대화를 지운다. 목록과 읽기에 더는 나오지 않는다.",
        "operationId": "delete_conversation_api_v1_chat_conversations__conversation_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Conversation",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      },
      "get": {
        "description": "대화 하나. 지금 보고 있는 가지의 말들까지.",
        "operationId": "read_conversation_api_v1_chat_conversations__conversation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Conversation",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/chat/me": {
      "get": {
        "description": "토큰이 유효하면 그 주인의 ID 를 돌려준다.",
        "operationId": "read_me_api_v1_chat_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Me",
        "tags": [
          "me"
        ],
        "x-audience": "user"
      }
    },
    "/health": {
      "get": {
        "description": "서버 프로세스가 요청을 받을 수 있으면 200 을 돌려준다.\n\nDB 나 다른 서버의 상태는 보지 않는다. 그것까지 보면, DB 가 잠깐 느려졌을 때\n관리 도구가 멀쩡한 서버를 죽은 것으로 보고 재시작한다.",
        "operationId": "check_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check Health",
        "tags": [
          "health"
        ],
        "x-audience": "infra"
      }
    },
    "/health/ready": {
      "get": {
        "description": "DB 에 3초 안에 닿으면 200, 아니면 503 을 돌려준다.\n\n왜 닿지 않는지는 응답에 싣지 않는다. 오류 문구에는 DB 의 주소와 계정 이름이 들어 있다.\n원인은 서버의 로그에 남긴다. 오류의 종류만 적는다.",
        "operationId": "check_readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Check Readiness",
        "tags": [
          "health"
        ],
        "x-audience": "infra"
      }
    }
  }
}
