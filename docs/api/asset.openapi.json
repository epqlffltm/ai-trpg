          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Me",
        "tags": [
          "me"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/asset/personas": {
      "get": {
        "description": "자기 페르소나 전부. 기본이 먼저, 그다음 만든 차례다.",
        "operationId": "list_personas_api_v1_asset_personas_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PersonaDetail"
                  },
                  "title": "Response List Personas Api V1 Asset Personas Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Personas",
        "tags": [
          "personas"
        ],
        "x-audience": "user"
      },
      "post": {
        "description": "페르소나를 만든다. 처음 만든 것이면 기본이다.",
        "operationId": "create_persona_api_v1_asset_personas_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonaCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonaDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Persona",
        "tags": [
          "personas"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/asset/personas/{persona_id}": {
      "delete": {
        "description": "자기 페르소나를 지운다. 기본이었으면 가장 먼저 만든 것이 기본이 된다.",
        "operationId": "delete_persona_api_v1_asset_personas__persona_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "persona_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Persona Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
