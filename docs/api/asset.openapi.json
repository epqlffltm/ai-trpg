    "/api/v1/asset/personas/{persona_id}/default": {
      "put": {
        "description": "자기 페르소나 하나를 기본으로 둔다. 다른 것은 기본에서 내린다. 이미 기본이어도 200 이다.",
        "operationId": "make_default_api_v1_asset_personas__persona_id__default_put",
        "parameters": [
          {
            "in": "path",
            "name": "persona_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Persona Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
