            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Persona",
        "tags": [
          "personas"
        ],
        "x-audience": "user"
      },
      "get": {
        "description": "자기 페르소나 하나.",
        "operationId": "read_persona_api_v1_asset_personas__persona_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "persona_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Persona Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonaDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Persona",
        "tags": [
          "personas"
        ],
        "x-audience": "user"
      },
      "patch": {
        "description": "자기 페르소나를 고친다. 보낸 칸만 바뀐다. 내용이 바뀌면 revision 이 오른다.",
        "operationId": "update_persona_api_v1_asset_personas__persona_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "persona_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Persona Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonaUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonaDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Update Persona",
        "tags": [
          "personas"
        ],
        "x-audience": "user"
      }
