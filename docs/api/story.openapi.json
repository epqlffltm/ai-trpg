{
  "components": {
    "schemas": {
      "ConversationCreate": {
        "additionalProperties": false,
        "description": "세션을 시작할 때 받는 값. 세계관을 고른다. 그 세계관의 마지막 판을 가져와 고정한다.\n\nmodel 은 셋 중 하나다(chat 과 같다).\n  - 보내지 않으면: 지난번 세션의 모델을 쓴다. 지난번에 없었거나 이 세션에 고를 수 없으면 모델 없이 시작한다\n  - null 을 보내면: 모델 없이 시작한다. 말을 보내기 전에 고른다\n  - 이름표를 보내면: 그 모델이다. 이 세션에 고를 수 없으면 422 model_unavailable 이다",
        "properties": {
          "model": {
            "anyOf": [
              {
                "maxLength": 48,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "world_id": {
            "format": "uuid",
            "title": "World Id",
            "type": "string"
          }
        },
        "required": [
          "world_id"
        ],
        "title": "ConversationCreate",
        "type": "object"
      },
      "ConversationDetail": {
        "description": "세션 하나. 말과 상태는 그것을 쓰는 조각에서 더한다(만드는 순서 2~5).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConversationModelOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "world": {
            "$ref": "#/components/schemas/WorldOut"
          }
        },
        "required": [
          "id",
          "title",
          "world",
          "model",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationDetail",
        "type": "object"
      },
      "ConversationModelOut": {
        "description": "세션에 싣는 모델. usable 이 거짓이면 이 세션에 더는 고를 수 없는 모델이다\n(꺼졌다, 은퇴했다, 성인 등급의 세션에 쓸 수 없게 됐다). 화면이 다시 고르게 한다. 서버는 몰래 바꾸지 않는다.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "grade": {
            "$ref": "#/components/schemas/Grade"
          },
          "retires_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retires On"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "usable": {
            "title": "Usable",
            "type": "boolean"
          },
          "vendor": {
            "title": "Vendor",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "display_name",
          "vendor",
          "grade",
          "retires_on",
          "usable"
        ],
        "title": "ConversationModelOut",
        "type": "object"
      },
      "ConversationPage": {
        "description": "목록의 한 쪽과 전체 개수. chat 의 GET /conversations 와 같은 모양이다(#593).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ConversationSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "ConversationPage",
        "type": "object"
      },
      "ConversationSummary": {
        "description": "목록의 한 줄.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConversationModelOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "world": {
            "$ref": "#/components/schemas/WorldSummary"
          }
        },
        "required": [
          "id",
          "title",
          "world",
          "model",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationSummary",
        "type": "object"
      },
      "Grade": {
        "description": "보이는 분류. 목록을 묶어 보이는 데만 쓴다. 값은 모델마다 모델 목록의 파일에 적는다.",
        "enum": [
          "basic",
          "standard",
          "premium"
        ],
        "title": "Grade",
        "type": "string"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InputError": {
        "properties": {
          "detail": {
            "description": "무엇이 잘못됐는가. 화면에 그대로 보여 줄 수 있는 문장이다",
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "칸의 이름(점으로 이은 경로)마다 틀린 까닭들이다",
            "type": "object"
          }
        },
        "required": [
          "detail",
          "errors"
        ],
        "title": "InputError",
        "type": "object"
      },
      "MeResponse": {
        "description": "토큰의 주인.",
        "properties": {
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ModelChoice": {
        "additionalProperties": false,
        "description": "세션의 모델을 바꿀 때 받는 값.",
        "properties": {
          "model": {
            "maxLength": 48,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "model"
        ],
        "title": "ModelChoice",
        "type": "object"
      },
      "ModelList": {
        "description": "고를 수 있는 모델들. 회사, 이름표 순서다.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ModelOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ModelList",
        "type": "object"
      },
      "ModelOut": {
        "description": "고를 수 있는 모델 하나. grade 는 화면의 묶음(basic, standard, premium)이다.",
        "properties": {
          "allows_adult": {
            "title": "Allows Adult",
            "type": "boolean"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "grade": {
            "$ref": "#/components/schemas/Grade"
          },
          "retires_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retires On"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "vendor": {
            "title": "Vendor",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "display_name",
          "vendor",
          "grade",
          "allows_adult",
          "retires_on"
        ],
        "title": "ModelOut",
        "type": "object"
      },
      "Rating": {
        "description": "이용 등급. asset 서버, chat 서버, 게임 서버와 같은 값이다.",
        "enum": [
          "all",
          "adult"
        ],
        "title": "Rating",
        "type": "string"
      },
      "WorldOut": {
        "description": "세션 하나에 싣는 세계관. 가져온 판의 문서까지다(받은 칸 전부).\n\n문서의 칸은 asset 서버의 판의 형식을 따른다(asset-server/README.md 의 \"세계관\").",
        "properties": {
          "document": {
            "additionalProperties": true,
            "title": "Document",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rating": {
            "$ref": "#/components/schemas/Rating"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "image_id",
          "rating",
          "document"
        ],
        "title": "WorldOut",
        "type": "object"
      },
      "WorldSummary": {
        "description": "목록에 싣는 세계관. id 는 asset 서버의 세계관 id 이고 version 은 이 세션이 쓰는 판의 번호다.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rating": {
            "$ref": "#/components/schemas/Rating"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "image_id",
          "rating"
        ],
        "title": "WorldSummary",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "AI TRPG story 서버",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/story/conversations": {
      "get": {
        "description": "내 세션의 목록. 최근의 것부터다.",
        "operationId": "list_conversations_api_v1_story_conversations_get",
        "parameters": [
          {
            "description": "asset 서버의 세계관 id. 주면 그 세계관의 세션만",
            "in": "query",
            "name": "world_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "asset 서버의 세계관 id. 주면 그 세계관의 세션만",
              "title": "World Id"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputError"
                }
              }
            },
            "description": "입력이 틀렸다"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Conversations",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      },
      "post": {
        "description": "세션을 시작한다. 세계관의 마지막 판을 가져와 고정한다. 모델은 지난번 것이거나 고른 것이다.",
        "operationId": "start_conversation_api_v1_story_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputError"
                }
              }
            },
            "description": "입력이 틀렸다"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Start Conversation",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/story/conversations/{conversation_id}": {
      "get": {
        "description": "세션 하나. 가져온 판까지.",
        "operationId": "read_conversation_api_v1_story_conversations__conversation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputError"
                }
              }
            },
            "description": "입력이 틀렸다"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Conversation",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/story/conversations/{conversation_id}/model": {
      "put": {
        "description": "세션의 모델을 바꾼다. 다음 말부터 그 모델로 쓴다. 바꾼 모델을 돌려준다.",
        "operationId": "change_model_api_v1_story_conversations__conversation_id__model_put",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelChoice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationModelOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputError"
                }
              }
            },
            "description": "입력이 틀렸다"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Change Model",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/story/me": {
      "get": {
        "description": "토큰이 유효하면 그 주인의 ID 를 돌려준다.",
        "operationId": "read_me_api_v1_story_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Me",
        "tags": [
          "me"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/story/models": {
      "get": {
        "description": "세션에 고를 수 있는 모델들. 회사, 이름표 순서다.",
        "operationId": "list_models_api_v1_story_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Models",
        "tags": [
          "models"
        ],
        "x-audience": "user"
      }
    },
    "/health": {
      "get": {
        "description": "서버 프로세스가 요청을 받을 수 있으면 200 을 돌려준다.\n\nDB 나 다른 서버의 상태는 보지 않는다. 그것까지 보면, DB 가 잠깐 느려졌을 때\n관리 도구가 멀쩡한 서버를 죽은 것으로 보고 재시작한다.",
        "operationId": "check_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check Health",
        "tags": [
          "health"
        ],
        "x-audience": "infra"
      }
    },
    "/health/ready": {
      "get": {
        "description": "DB 에 3초 안에 닿으면 200, 아니면 503 을 돌려준다.\n\n왜 닿지 않는지는 응답에 싣지 않는다. 오류 문구에는 DB 의 주소와 계정 이름이 들어 있다.\n원인은 서버의 로그에 남긴다. 오류의 종류만 적는다.",
        "operationId": "check_readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Check Readiness",
        "tags": [
          "health"
        ],
        "x-audience": "infra"
      }
    }
  }
}
