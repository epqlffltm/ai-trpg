{
  "components": {
    "schemas": {
      "ConversationCreate": {
        "additionalProperties": false,
        "description": "세션을 시작할 때 받는 값. 세계관만 고른다. 그 세계관의 마지막 판을 가져와 고정한다.",
        "properties": {
          "world_id": {
            "format": "uuid",
            "title": "World Id",
            "type": "string"
          }
        },
        "required": [
          "world_id"
        ],
        "title": "ConversationCreate",
        "type": "object"
      },
      "ConversationDetail": {
        "description": "세션 하나. 말과 상태는 그것을 쓰는 조각에서 더한다(만드는 순서 2~5).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "world": {
            "$ref": "#/components/schemas/WorldOut"
          }
        },
        "required": [
          "id",
          "title",
          "world",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationDetail",
        "type": "object"
      },
      "ConversationPage": {
        "description": "목록의 한 쪽과 전체 개수. chat 의 GET /conversations 와 같은 모양이다(#593).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ConversationSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "ConversationPage",
        "type": "object"
      },
      "ConversationSummary": {
        "description": "목록의 한 줄.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "world": {
            "$ref": "#/components/schemas/WorldSummary"
          }
        },
        "required": [
          "id",
          "title",
          "world",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MeResponse": {
        "description": "토큰의 주인.",
        "properties": {
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "Rating": {
        "description": "이용 등급. asset 서버, chat 서버, 게임 서버와 같은 값이다.",
        "enum": [
          "all",
          "adult"
        ],
        "title": "Rating",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorldOut": {
        "description": "세션 하나에 싣는 세계관. 가져온 판의 문서까지다(받은 칸 전부).\n\n문서의 칸은 asset 서버의 판의 형식을 따른다(asset-server/README.md 의 \"세계관\").",
        "properties": {
          "document": {
            "additionalProperties": true,
            "title": "Document",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rating": {
            "$ref": "#/components/schemas/Rating"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "image_id",
          "rating",
          "document"
        ],
        "title": "WorldOut",
        "type": "object"
      },
      "WorldSummary": {
        "description": "목록에 싣는 세계관. id 는 asset 서버의 세계관 id 이고 version 은 이 세션이 쓰는 판의 번호다.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rating": {
            "$ref": "#/components/schemas/Rating"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "image_id",
          "rating"
        ],
        "title": "WorldSummary",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "AI TRPG story 서버",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/story/conversations": {
      "get": {
        "description": "내 세션의 목록. 최근의 것부터다.",
        "operationId": "list_conversations_api_v1_story_conversations_get",
        "parameters": [
          {
            "description": "asset 서버의 세계관 id. 주면 그 세계관의 세션만",
            "in": "query",
            "name": "world_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "asset 서버의 세계관 id. 주면 그 세계관의 세션만",
              "title": "World Id"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Conversations",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      },
      "post": {
        "description": "세션을 시작한다. 세계관의 마지막 판을 가져와 고정한다.",
        "operationId": "start_conversation_api_v1_story_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Start Conversation",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/story/conversations/{conversation_id}": {
      "get": {
        "description": "세션 하나. 가져온 판까지.",
        "operationId": "read_conversation_api_v1_story_conversations__conversation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Conversation",
        "tags": [
          "conversations"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/story/me": {
      "get": {
        "description": "토큰이 유효하면 그 주인의 ID 를 돌려준다.",
        "operationId": "read_me_api_v1_story_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Me",
        "tags": [
          "me"
        ],
        "x-audience": "user"
      }
    },
    "/health": {
      "get": {
        "description": "서버 프로세스가 요청을 받을 수 있으면 200 을 돌려준다.\n\nDB 나 다른 서버의 상태는 보지 않는다. 그것까지 보면, DB 가 잠깐 느려졌을 때\n관리 도구가 멀쩡한 서버를 죽은 것으로 보고 재시작한다.",
        "operationId": "check_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check Health",
        "tags": [
          "health"
        ],
        "x-audience": "infra"
      }
    },
    "/health/ready": {
      "get": {
        "description": "DB 에 3초 안에 닿으면 200, 아니면 503 을 돌려준다.\n\n왜 닿지 않는지는 응답에 싣지 않는다. 오류 문구에는 DB 의 주소와 계정 이름이 들어 있다.\n원인은 서버의 로그에 남긴다. 오류의 종류만 적는다.",
        "operationId": "check_readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Check Readiness",
        "tags": [
          "health"
        ],
        "x-audience": "infra"
      }
    }
  }
}
