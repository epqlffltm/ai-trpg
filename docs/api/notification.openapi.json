{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "KindMute": {
        "description": "끌 수 있는 종류 하나와 그것을 껐는지.",
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "muted": {
            "title": "Muted",
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "muted"
        ],
        "title": "KindMute",
        "type": "object"
      },
      "MuteSettings": {
        "description": "이 사람의 알림 끄기 설정. 끌 수 있는 종류 전부다(이름 차례). 끌 수 없는 종류는 싣지 않는다.\n\n화면은 이것으로 켜고 끄는 단추를 그린다. 종류의 이름을 사람의 말로 바꾸는 것은 화면이 한다.",
        "properties": {
          "kinds": {
            "items": {
              "$ref": "#/components/schemas/KindMute"
            },
            "title": "Kinds",
            "type": "array"
          }
        },
        "required": [
          "kinds"
        ],
        "title": "MuteSettings",
        "type": "object"
      },
      "NotificationPage": {
        "description": "알림함의 한 쪽. 최근 것부터다.\n\nnext_before 가 있으면 그 값을 before 로 다시 부르면 다음 쪽이다. 없으면 끝이다.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NotificationView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_before": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Before"
          }
        },
        "required": [
          "items",
          "next_before"
        ],
        "title": "NotificationPage",
        "type": "object"
      },
      "NotificationPut": {
        "description": "넣기의 답. 넣는 서버는 이것을 받으면 발송함에서 그 줄을 지운다.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "status": {
            "$ref": "#/components/schemas/PutStatus"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "NotificationPut",
        "type": "object"
      },
      "NotificationView": {
        "description": "알림함에 보이는 알림 하나. 넣은 서버가 붙인 열쇠(source_key)와 받는 사람은 싣지 않는다(내 것이다).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "read_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Read At"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "kind",
          "payload",
          "created_at",
          "read_at"
        ],
        "title": "NotificationView",
        "type": "object"
      },
      "PutStatus": {
        "description": "넣기의 결과.",
        "enum": [
          "created",
          "existing",
          "muted"
        ],
        "title": "PutStatus",
        "type": "string"
      },
      "ReadAllRequest": {
        "additionalProperties": false,
        "description": "모두 읽음. up_to 번호까지(그 번호 포함) 읽지 않은 알림을 읽음으로 한다.\n\n화면이 마지막으로 받은 알림의 번호를 보낸다. \"지금까지 전부\"로 하면, 목록을 받은 뒤에 막 들어와\n화면에 보이지도 않은 알림까지 읽음이 된다.",
        "properties": {
          "up_to": {
            "minimum": 1.0,
            "title": "Up To",
            "type": "integer"
          }
        },
        "required": [
          "up_to"
        ],
        "title": "ReadAllRequest",
        "type": "object"
      },
      "ReadAllResult": {
        "description": "모두 읽음의 결과. 이번에 읽음이 된 알림의 수다.",
        "properties": {
          "read": {
            "title": "Read",
            "type": "integer"
          }
        },
        "required": [
          "read"
        ],
        "title": "ReadAllResult",
        "type": "object"
      },
      "UnreadCount": {
        "description": "읽지 않은 알림의 수.",
        "properties": {
          "unread": {
            "title": "Unread",
            "type": "integer"
          }
        },
        "required": [
          "unread"
        ],
        "title": "UnreadCount",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WithdrawalOut": {
        "description": "탈퇴를 받은 답. 지운 수는 싣지 않는다. 인증 서버는 결과만 본다.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/WithdrawalStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "WithdrawalOut",
        "type": "object"
      },
      "WithdrawalStatus": {
        "description": "탈퇴를 받은 결과. 인증 서버는 processed 를 받아야 보내기를 멈춘다.",
        "enum": [
          "processed"
        ],
        "title": "WithdrawalStatus",
        "type": "string"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "AI TRPG 알림 서버",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/notification/me/notifications": {
      "get": {
        "description": "내 알림을 최근 것부터 읽는다. 다음 쪽은 받은 next_before 를 before 로 넘긴다.",
        "operationId": "list_notifications_api_v1_notification_me_notifications_get",
        "parameters": [
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Notifications",
        "tags": [
          "inbox"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/notification/me/notifications/mutes": {
      "get": {
        "description": "끌 수 있는 종류마다 껐는지 읽는다.",
        "operationId": "read_mutes_api_v1_notification_me_notifications_mutes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MuteSettings"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Mutes",
        "tags": [
          "inbox"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/notification/me/notifications/mutes/{kind}": {
      "delete": {
        "description": "그 종류를 다시 켠다. 이미 켜져 있어도 200 이다.",
        "operationId": "unmute_kind_api_v1_notification_me_notifications_mutes__kind__delete",
        "parameters": [
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Kind",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MuteSettings"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "끌 수 없거나 표에 없는 종류다"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Unmute Kind",
        "tags": [
          "inbox"
        ],
        "x-audience": "user"
      },
      "put": {
        "description": "그 종류를 끈다. 이미 꺼져 있어도 200 이다.",
        "operationId": "mute_kind_api_v1_notification_me_notifications_mutes__kind__put",
        "parameters": [
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Kind",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MuteSettings"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "끌 수 없거나 표에 없는 종류다"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Mute Kind",
        "tags": [
          "inbox"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/notification/me/notifications/read-all": {
      "post": {
        "description": "번호 up_to 까지의 읽지 않은 알림을 모두 읽음으로 한다. 이번에 읽음이 된 수를 돌려준다.",
        "operationId": "read_all_api_v1_notification_me_notifications_read_all_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadAllRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadAllResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read All",
        "tags": [
          "inbox"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/notification/me/notifications/unread-count": {
      "get": {
        "description": "읽지 않은 알림의 수. 화면의 종 모양 옆 숫자다.",
        "operationId": "count_unread_api_v1_notification_me_notifications_unread_count_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadCount"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Count Unread",
        "tags": [
          "inbox"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/notification/me/notifications/{notification_id}/read": {
      "post": {
        "description": "알림 하나를 읽음으로 한다. 이미 읽었으면 처음 읽은 시각 그대로 200 이다.",
        "operationId": "read_one_api_v1_notification_me_notifications__notification_id__read_post",
        "parameters": [
          {
            "in": "path",
            "name": "notification_id",
            "required": true,
            "schema": {
              "title": "Notification Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "그런 알림이 없거나 남의 것이다"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read One",
        "tags": [
          "inbox"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/notification/service/users/{user_id}/withdrawal": {
      "post": {
        "description": "그 사람의 알림과 끈 종류를 지운다. 지웠든, 이미 지웠든, 없던 사람이든 200 이다.",
        "operationId": "receive_withdrawal_api_v1_notification_service_users__user_id__withdrawal_post",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WithdrawalOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "서명이 없거나 맞지 않다(AUTH_SERVER_SECRET)"
          },
          "413": {
            "description": "본문이 16KB 를 넘는다"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Receive Withdrawal",
        "tags": [
          "service"
        ],
        "x-audience": "service"
      }
    },
    "/api/v1/notification/service/{source}/notifications": {
      "post": {
        "description": "알림 하나를 넣는다. 같은 알림을 다시 보내면 같은 id 로 200 이다. 받는 사람이 껐으면 적지 않고 200 이다.",
        "operationId": "put_notification_api_v1_notification_service__source__notifications_post",
        "parameters": [
          {
            "in": "path",
            "name": "source",
            "required": true,
            "schema": {
              "pattern": "^[a-z][a-z0-9_-]{0,31}$",
              "title": "Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPut"
                }
              }
            },
            "description": "같은 알림을 다시 보냈다(existing). 받는 사람이 그 종류를 꺼서 적지 않았다(muted)"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "서명이 없거나 맞지 않다"
          },
          "409": {
            "description": "같은 열쇠의 다른 알림이다"
          },
          "413": {
            "description": "본문이 16KB 를 넘는다"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Put Notification",
        "tags": [
          "service"
        ],
        "x-audience": "service"
      }
    },
    "/health": {
      "get": {
        "description": "서버 프로세스가 요청을 받을 수 있으면 200 을 돌려준다.\n\nDB 나 다른 서버의 상태는 보지 않는다. 그것까지 보면, DB 가 잠깐 느려졌을 때\n관리 도구가 멀쩡한 서버를 죽은 것으로 보고 재시작한다.",
        "operationId": "check_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check Health",
        "tags": [
          "health"
        ],
        "x-audience": "infra"
      }
    },
    "/health/ready": {
      "get": {
        "description": "DB 에 3초 안에 닿으면 200, 아니면 503 을 돌려준다.\n\n왜 닿지 않는지는 응답에 싣지 않는다. 오류 문구에는 DB 의 주소와 계정 이름이 들어 있다.\n원인은 서버의 로그에 남긴다. 오류의 종류만 적는다.",
        "operationId": "check_readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Check Readiness",
        "tags": [
          "health"
        ],
        "x-audience": "infra"
      }
    }
  }
}
