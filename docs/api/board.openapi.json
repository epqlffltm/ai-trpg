{
  "components": {
    "schemas": {
      "BoardResponse": {
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "write_policy": {
            "description": "누가 글을 쓸 수 있는가. member 는 로그인한 누구나, operator 는 운영자만",
            "enum": [
              "operator",
              "member"
            ],
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "description",
          "write_policy"
        ],
        "type": "object"
      },
      "CommentListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CommentThreadResponse"
            },
            "type": "array"
          },
          "next": {
            "description": "다음 토막을 부를 때 after 에 넣을 값. 뒤에 더 없으면 null 이다",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "items",
          "next"
        ],
        "type": "object"
      },
      "CommentResponse": {
        "properties": {
          "author_id": {
            "description": "글쓴이. 지운 댓글이면 null",
            "nullable": true,
            "type": "string"
          },
          "author_nickname": {
            "description": "글쓴이의 닉네임. 지운 댓글이거나 이 서버가 이름을 모르는 사람이면 null",
            "nullable": true,
            "type": "string"
          },
          "content": {
            "description": "내용. 지운 댓글이면 null",
            "nullable": true,
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "deleted": {
            "description": "지운 댓글인가. 답글이 달려 있어 자리만 남은 것이다",
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "parent_id": {
            "description": "답글이면 어느 댓글에 단 것인가. 글에 단 댓글이면 null",
            "nullable": true,
            "type": "string"
          },
          "post_id": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "post_id",
          "parent_id",
          "author_id",
          "author_nickname",
          "content",
          "deleted",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "CommentThreadResponse": {
        "properties": {
          "author_id": {
            "description": "글쓴이. 지운 댓글이면 null",
            "nullable": true,
            "type": "string"
          },
          "author_nickname": {
            "description": "글쓴이의 닉네임. 지운 댓글이거나 이 서버가 이름을 모르는 사람이면 null",
