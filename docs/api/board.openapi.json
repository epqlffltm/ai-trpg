          "author_id",
          "author_nickname",
          "content",
          "deleted",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "CreateCommentDto": {
        "properties": {
          "content": {
            "description": "내용. 받은 그대로 저장한다",
            "maxLength": 2000,
            "type": "string"
          },
          "parent_id": {
            "description": "답글이면 어느 댓글에 다는가. 적지 않거나 null 이면 글에 다는 댓글이다. 번호는 글자로 보낸다(\"57\").\nnull 을 받는 것은 화면이 \"답글이 아님\"을 null 로 보내기 쉬워서다",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "type": "object"
      },
      "CreatePostDto": {
        "properties": {
          "content": {
            "description": "본문. 받은 그대로 저장한다. 줄바꿈과 들여쓰기가 글의 일부다",
            "maxLength": 20000,
            "type": "string"
          },
          "title": {
            "description": "제목. 앞뒤 빈칸은 떼고 저장한다",
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "type": "object"
      },
      "CreateReportDto": {
        "properties": {
          "description": {
            "description": "설명. 받은 그대로 저장한다. 적지 않거나 null 이면 설명이 없는 것이다",
            "nullable": true,
            "type": "string"
          },
          "reason": {
            "description": "사유",
            "enum": [
              "spam",
              "abuse",
              "sexual",
              "illegal",
              "other"
            ],
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "detail": {
            "description": "무엇이 잘못됐는가. 화면에 그대로 보여 줄 수 있는 문장이다",
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "입력이 틀렸을 때만 있다. 칸의 이름마다 틀린 까닭들이다",
            "type": "object"
          },
          "retry_after": {
            "description": "너무 자주 불러서 거절했을 때만 있다. 몇 초 뒤에 다시 부르면 되는가",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "detail"
        ],
        "type": "object"
      },
      "HandleReportsDto": {
        "properties": {
          "outcome": {
            "description": "처리한 결과. 조치함(actioned), 문제없음(dismissed)",
