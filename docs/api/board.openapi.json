  "info": {
    "contact": {},
    "description": "게시판과 글, 댓글, 신고, 글 고정.",
    "title": "AI TRPG 게시판 서버",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/board/boards": {
      "get": {
        "operationId": "BoardsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BoardResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "오류. 상태 코드가 무엇이든 본문은 이 모양이다"
          }
        },
        "security": [
          {}
        ],
        "summary": "게시판을 정해 둔 차례대로 모두 돌려준다.",
        "tags": [
          "Boards"
        ],
        "x-audience": "user"
      }
    },
    "/api/v1/board/boards/{slug}/posts": {
      "get": {
        "operationId": "PostsController_list",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "몇 번째 쪽인가. 1 부터 센다",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 10000,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "description": "한 쪽에 몇 개를 담는가",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "type": "number"
            }
