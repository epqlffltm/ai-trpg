# auth-server/.env.example
# 인증 서버 설정. auth-server/.env 를 만들고 값을 채운다. .env 는 커밋하지 않는다.
#
# 비밀(SECRET_KEY, DB 비밀번호, BILLING_SECRET)은 저장소 루트에서 이 명령이 채운다. 다른 서버의 짝과 같은 값으로 맞춘다
#   uv run --no-project python tools/fill_env.py
# 손으로 만들려면 복사해서 값을 채운다:  cp .env.example .env

# Django 의 비밀키. 세션과 서명, 발송함의 암호화, 인증 코드의 해시에 쓴다. 비밀값이다.
# tools/fill_env.py 가 채운다. 손으로 만들려면:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# 개발 중에만 true. Django 의 오류 화면 같은 개발용 기능을 켠다. 적지 않으면 false 로 동작한다.
# APP_ENVIRONMENT 가 staging, production 이면 켤 수 없다(서버가 뜨지 않는다)
DEBUG=true

# 이 서버가 답하는 호스트 이름. 쉼표로 구분한다. 다른 이름으로 온 요청은 400 이다
ALLOWED_HOSTS=localhost,127.0.0.1

# DB 접속 주소. postgres://계정:비밀번호@호스트:포트/DB이름
# 비밀번호는 루트 .env 의 AUTH_DB_PASSWORD 와 같은 값이다(tools/fill_env.py 가 맞춘다). 포트는 루트 .env 의 POSTGRES_PORT 다
DATABASE_URL=postgres://auth:여기에_비밀번호@127.0.0.1:5432/trpg

# --- 보안 이벤트 요약 메일 ---
# 요약 메일(manage.py send_security_digest)을 받을 운영자의 주소. 쉼표로 여러 개를 적는다.
# 적지 않으면 요약 메일을 보내지 않는다. 사건은 관리자 화면에서만 볼 수 있다
# SECURITY_DIGEST_TO=operator@example.com

# --- Redis ---
# 시도 횟수 제한에 쓰는 Redis 의 주소. 죽어 있어도 서버는 돈다(제한 없이 통과시킨다).
# 포트는 루트 .env 의 REDIS_PORT 와 같은 값이다. 적지 않으면 아래 값으로 동작한다
# REDIS_URL=redis://127.0.0.1:6379/0

# --- 프록시 ---
# 서버 앞에 선, 우리가 운영하는 프록시(nginx, 로드밸런서)의 수. 적지 않으면 0 이다.
# 프록시 없이 직접 띄우는 개발 환경은 0 으로 둔다.
# 실제 구조와 다르면 IP 별 시도 제한이 무력해지거나(너무 큼) 모든 사용자가 함께 막힌다(너무 작음)
# TRUSTED_PROXY_COUNT=0

# --- JWT ---
# 서명용 개인키 파일의 경로. 상대 경로는 auth-server 폴더 기준이다.
# 파일은 아래 명령으로 만든다. 커밋하지 않는다(tools/fill_env.py 는 만들지 않는다)
#   uv run python scripts/generate_jwt_key.py
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem

# 서명하지 않고 검증만 하는 공개키 파일들. 쉼표로 구분한다. 평소에는 비워 둔다.
# 키를 교체하는 동안 옛 키와 미리 알릴 다음 키의 공개키를 적는다(README 의 "JWT 키 교체")
# JWT_EXTRA_PUBLIC_KEY_PATHS=keys/jwt-public-old.pem

# 토큰의 발급자(iss). 토큰을 받는 서버들도 이 이름을 믿는다
JWT_ISSUER=ai-trpg-auth

# 토큰을 받아 쓸 서버들(aud). 쉼표로 구분한다.
# 각 서버는 토큰을 검증할 때 aud 에 자기 이름이 있는지 확인한다
# 인증 서버, 게임 서버, 게시판 서버, 결제 서버, 알림 서버, asset 서버, chat 서버, story 서버(둘은 아직 없다)의 순서다. 서버가 늘면 여기에 이름을 더한다
JWT_AUDIENCE=ai-trpg-auth,ai-trpg-game,ai-trpg-board,ai-trpg-billing,ai-trpg-notification,ai-trpg-asset,ai-trpg-chat,ai-trpg-story

# refresh 토큰 쿠키를 HTTPS 에서만 보낼지. 적지 않으면 true 로 동작한다.
# 로컬 개발은 HTTP 라서 false 로 둔다. 배포 환경에서는 이 줄을 지우거나 true 로 둔다
REFRESH_COOKIE_SECURE=false

# refresh 와 logout 을 부를 수 있는 출처(화면을 여는 주소). 쉼표로 구분하고 경로 없이 적는다.
# 요청의 Origin 머리말과 비교한다. 개발에서 적지 않으면 compose 의 nginx 주소(localhost:8080, 127.0.0.1:8080)다.
# 운영에서는 꼭 적고 https 여야 한다. 예: https://play.example.com
# REFRESH_COOKIE_ALLOWED_ORIGINS=http://localhost:8080

# --- 메일 ---
# 메일 서버의 주소. 적지 않으면 메일을 보내지 않고 runserver 를 띄운 터미널에 출력한다
# SMTP_HOST=smtp.gmail.com
# 메일 서버의 포트. 587 은 STARTTLS 다
# SMTP_PORT=587
# 메일 서버에 로그인하는 계정. Gmail 은 그 주소다
# SMTP_USER=내주소@gmail.com
# 메일 서버의 비밀번호. 비밀값이다. 메일 서비스가 내주는 값이라 tools/fill_env.py 가 만들지 않는다.
# Gmail 은 2단계 인증을 켠 뒤 앱 비밀번호를 만들어 넣는다. 계정의 비밀번호가 아니다
#   https://myaccount.google.com/apppasswords
# SMTP_PASSWORD=

# 메일의 보내는 사람 주소. 적지 않으면 아래 값으로 동작한다.
# Gmail 로 보낼 때는 SMTP_USER 와 같은 주소를 쓴다. 다른 주소를 적어도 Gmail 이 계정 주소로 바꾼다
# DEFAULT_FROM_EMAIL=AI TRPG <no-reply@localhost>

# 메일을 언제 보내는가. 적지 않으면 SMTP_HOST 가 있을 때 outbox, 없을 때 inline 이다.
#   outbox: 발송함(DB)에 적고 워커(manage.py send_outgoing_mail)가 보낸다
#   inline: 요청 자리에서 바로 보낸다. 워커 없이 개발할 때만 쓴다
# MAIL_DELIVERY=outbox

# 비밀번호 재설정 메일의 링크가 가리키는 프론트 화면. 적지 않으면 아래 값으로 동작한다
# PASSWORD_RESET_URL=http://localhost:5173/reset-password
# 보호자 동의 메일의 링크가 가리키는 프론트 화면. 적지 않으면 아래 값으로 동작한다
# GUARDIAN_CONSENT_URL=http://localhost:5173/guardian/consent
# 보호자가 동의를 거두는 링크가 가리키는 프론트 화면. 적지 않으면 아래 값으로 동작한다
# GUARDIAN_REVOKE_URL=http://localhost:5173/guardian/revoke

# --- 결제 서버 (환영 크레딧) ---
# 본인인증을 마친 사용자에게 환영 크레딧을 주라고 결제 서버에 맡긴다. 맡기는 것은 워커다(manage.py send_welcome_credits).
# 적지 않아도 서버는 뜬다. 맡길 일이 DB 에 쌓였다가, 적은 뒤에 워커가 내보낸다.
# 결제 서버의 주소. 적지 않으면 아래 값으로 동작한다
# BILLING_URL=http://127.0.0.1:8003
# 결제 서버와 함께 아는 비밀. 32자 이상. billing-server/.env 의 AUTH_SERVER_SECRET 과 같은 값이어야 한다.
# tools/fill_env.py 가 두 파일에 같은 값을 채우고 주석을 푼다.
# 결제 서버가 보낸 보호자 결제 알림(#352)의 서명도 이 값으로 확인한다. 없으면 그 알림을 받지 않는다(401)
# BILLING_SECRET=

# --- 탈퇴 알림(docs/architecture/withdrawal.md 의 "서버마다의 이름") ---
# 유예가 지난 탈퇴를 다른 서버에 알린다. 알리는 것은 워커다(manage.py send_welcome_credits).
# 서버마다 주소와 서명 비밀이다. 비밀은 받는 서버마다 따로다. 32자 이상. 비밀값이다.
# 비밀이 비어 있는 서버에는 알리지 않는다. 알릴 줄은 쌓여 있다가 비밀을 적은 뒤에 나간다.
# tools/fill_env.py 가 받는 서버의 짝과 같은 값을 채우고 주석을 푼다. 주소는 적지 않으면 아래 값이다
# asset 서버(페르소나, 비공개 캐릭터를 지운다). asset-server/.env 의 AUTH_SERVER_SECRET 과 같은 값이다
# ASSET_URL=http://127.0.0.1:8006
# ASSET_SECRET=
# 게임 서버(보관함을 지우고, 시나리오의 공개를 내리고, 테이블에서 나간다). trpg-server/.env 의 AUTH_SERVER_SECRET 과 같은 값이다
# GAME_URL=http://127.0.0.1:8001
# GAME_SECRET=

# --- 본인확인 (휴대폰 본인인증) ---
# 본인확인 업체. fake(가짜 업체, 개발용) 또는 disabled(받지 않음). 적지 않으면 운영은 disabled, 그 밖은 fake 다.
# 운영에서 fake 로는 뜨지 않는다. 실제 업체는 사업자 계약 뒤에 붙인다(config/identity.py)
# IDENTITY_PROVIDER=fake

# --- 로그에 실리는 값들 ---
# 비밀값이 아니다. 규격은 저장소 루트의 docs/observability.md 에 있다.
# 이 서버가 도는 환경의 이름. 적지 않으면 development 다. VM 에 올린 운영자용 서버는 staging, 운영에서는 production 으로 적는다.
# staging 과 production 이면 DEBUG=true·꺼진 REFRESH_COOKIE_SECURE·비어 있거나 http 인 REFRESH_COOKIE_ALLOWED_ORIGINS 로는 뜨지 않는다.
# 이 파일의 DEBUG=true, REFRESH_COOKIE_SECURE=false 는 로컬 개발의 값이라 VM 에서는 바꿔 적는다.
# production 이면 더해서 관리자 화면의 쿠키에 Secure 가 붙고, 빈 SMTP_HOST·IDENTITY_PROVIDER=fake 로는 뜨지 않는다
# APP_ENVIRONMENT=development
# 배포한 코드의 버전. 적지 않으면 dev 다. 운영에서는 배포할 때 git SHA 나 이미지 태그를 넣는다
# APP_VERSION=dev
# 이 수준부터 로그를 남긴다. debug, info, warning, error 중 하나다. 적지 않으면 info 다
# LOG_LEVEL=info
# span 과 메트릭을 OTLP(HTTP)로 미는 수집기(Alloy)의 주소. 경로 없이 적는다. 적지 않으면 내보내지 않는다(README 의 "추적", "메트릭").
# PC 에서 직접 띄울 때는 적지 않는다. compose 는 루트 .env 의 같은 이름을 넘긴다
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# 메트릭을 보내는 간격(밀리초). 1000 이상. 적지 않으면 15000 이다
# OTEL_METRIC_EXPORT_INTERVAL=15000
