# notification-server/.env.example
# 알림 서버 설정. notification-server/.env 를 만들고 값을 채운다. .env 는 커밋하지 않는다. 다른 서버의 .env 와 따로 둔다.
#
# 비밀(DB 비밀번호, 알림을 넣는 서버마다의 비밀)은 저장소 루트에서 이 명령이 채운다. 넣는 서버의 짝과 같은 값으로 맞춘다
#   uv run --no-project python tools/fill_env.py
# 손으로 만들려면 복사해서 값을 채운다:  cp .env.example .env

# 개발용 기능(API 문서 화면)을 켠다. 운영에서는 적지 않거나 false 로 둔다
DEBUG=true

# DB 접속 주소. 비밀번호는 루트 .env 의 NOTIFICATION_DB_PASSWORD 와 같은 값이다(tools/fill_env.py 가 맞춘다).
# 포트는 루트 .env 의 POSTGRES_PORT 다. 비동기 드라이버라 postgresql+asyncpg:// 로 시작한다
DATABASE_URL=postgresql+asyncpg://notification:여기에비밀번호@127.0.0.1:5432/trpg

# 인증 서버가 공개키를 내주는 주소. 이 주소에서 받은 키로 서명된 토큰을 믿는다.
# 끊긴 세션의 목록은 그 옆(…/session-revocations)에서 받는다
AUTH_JWKS_URL=http://127.0.0.1:8000/api/v1/auth/jwks

# 알림을 넣는 서버마다의 서명 비밀. 비워 두면 그 서버의 알림은 받지 않는다. 적으면 32자 이상이고 서로 달라야 한다.
# tools/fill_env.py 가 넣는 서버의 짝과 같은 값으로 채운다.
# 게임 서버가 방장에게 넣는 알림. trpg-server/.env 의 NOTIFICATION_SECRET 과 같은 값이다
GAME_SERVER_SECRET=
# 결제 서버의 정리 작업이 넣는 알림. billing-server/.env 의 NOTIFICATION_SECRET 과 같은 값이다
BILLING_SERVER_SECRET=
# 게시판 서버가 넣는 댓글과 답글의 알림. board-server/.env 의 NOTIFICATION_SECRET 과 같은 값이다
BOARD_SERVER_SECRET=
